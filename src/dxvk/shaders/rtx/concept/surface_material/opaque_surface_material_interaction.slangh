#pragma once

#include "opaque_surface_material_blending.slangh"
#include "rtx/concept/vgui/vgui_evaluator.slangh"

// Opaque Surface Material Interaction Constants

// Note: Threshold value to use for considering the albedo zero or non-zero for some calculations.
static const f16vec3 albedoThreshold = f16vec3(1.0h / 256.0h);
// Note: Threshold value to use for considering the base reflectivity zero or non-zero for some calculations.
static const f16vec3 baseReflectivityThreshold = f16vec3(1.0h / 256.0h);
// Note: Threshold value to use for considering the roughness (not the perceptual roughness) zero or non-zero for some calculations.
// Must be greater than materialMinimumRoughness in the BRDF helpers as all roughnesses will be clamped to at minimum this value.
static const float16_t roughnessThreshold = float16_t(0.001h);

// Note: When set to 1 this enables bounded VNDF sampling, when set to 0 this uses original unbounded VNDF sampling.
// Generally bounded should be preferred as it has better performance (due to using spherical cap sampling) as well
// as generating fewer invalid samples.
#define OPAQUE_MATERIAL_USE_BOUNDED_VNDF_SAMPLING 1

// Opaque Surface Material Interaction Helper Functions

#ifdef OPAQUE_MATERIAL_USE_POM
// Parallax Occlusion Mapping Helper Functions
// Define a `box` as a region in tangent space that corresponds to a pixel in a mipmap level, with min_z = 0 and max_z equal to the max height in that region.

// get the smaller corner of the box that contains 'pos'
float2 pomGetBoxCorner(float2 pos, float2 boxSize)
{
  return floor(pos / boxSize) * boxSize;
}

// size in tangent space of a box at a given mip level
float2 pomGetBoxSize(uint level, uint2 fullBoxSize)
{
  uint2 levelSize =  max(fullBoxSize >> level, 1u);
  return 1.f / levelSize;
}

float pomGetBoxHeight(Texture2D texture, SamplerState sampler, float2 boxCenter, uint level) 
{
  return texture.SampleLevel(sampler, boxCenter, level - cb.totalMipBias).r;
}

float4 pomGetPatchCorners(Texture2D texture, SamplerState sampler, float2 boxCenter, float2 boxStep, float height, uint level)
{
  // Read the 3x3 patch around the current box
  const float box00 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2(-1.f, -1.f), level);
  const float box01 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2(-1.f,  0.f), level);
  const float box02 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2(-1.f,  1.f), level);
  const float box10 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2( 0.f, -1.f), level);
  // const float box11 = height;
  const float box12 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2( 0.f,  1.f), level);
  const float box20 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2( 1.f, -1.f), level);
  const float box21 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2( 1.f,  0.f), level);
  const float box22 = pomGetBoxHeight(texture, sampler, boxCenter + boxStep * float2( 1.f,  1.f), level);

  // Set each corner of the box to the min of the surrounding boxes.  This is needed because the mip values are maximum heights,
  // and we want each box to share corners.
  // returns a float4 representing the height of each corner, as 00, 01, 10, 11.
  return float4(
    min(min(box00, box01), min(box10, height)),
    min(min(box01, box02), min(height, box12)),
    min(min(box10, height), min(box20, box21)),
    min(min(height, box12), min(box21, box22))
  );
}

// cast a ray in tangent space.  return an intersection point in tangent point (or an exit point if z > 1.0f)
float3 pomTraceRay(
  Texture2D texture,
  SamplerState sampler,
  float3 origin,
  float3 direction,
  float2 textureGradientX,
  float2 textureGradientY,
  inout uint iterations,
  float neutralHeight)
{
  // Potential future improvements for outwards rays:
  // 1) calculate starting height the same way the box intersection code does instead of just sampling at a pixel.
  // 2) allow rays to escape the surface, only do intersection on entering the surface.
  uint fullWidth, fullHeight, numMipLevels = 0;
  texture.GetDimensions(0, fullWidth, fullHeight, numMipLevels);
  const uint2 fullBoxSize = uint2(fullWidth, fullHeight);
  const bool isOutwardsRay = direction.z > 0.f;
  const float2 ddx_tex = textureGradientX * fullBoxSize;
  const float2 ddy_tex = textureGradientY * fullBoxSize;
  const float dd_max_sq = max(dot(ddx_tex, ddx_tex), dot(ddy_tex, ddy_tex));
  uint minMipLevel = max(0, min(numMipLevels, log2(sqrt(dd_max_sq)) + cb.totalMipBias));

  origin.xy = origin.xy + (direction.xy * (1.f - neutralHeight)) / direction.z;

  // Starting halfway down the quadtree seems to generally lead to fewer iterations to resolve, especially for heights close to 1.
  // Outwards rays start at 0, since they will just descend to 0 if they start anywhere else.
  int level = isOutwardsRay ? 0 : max((numMipLevels - 1) / 2, minMipLevel);
  float3 curPos = origin;

  const float2 forwardStep = float2(direction.x >= 0.0f ? 1.f : -1.f, direction.y >= 0.0f ? 1.f : -1.f);
  const float2 forwardHalfStep = forwardStep * 0.5f;
  iterations = 0;
  level = level;
  float prevHeight = 1.f;
  while (level >= minMipLevel && iterations < cb.pomMaxIterations && (!isOutwardsRay || curPos.z <= 1.f))
  {
    iterations++;
    const float2 boxSize = pomGetBoxSize(level, fullBoxSize);
    const float2 boxCenter = pomGetBoxCorner(curPos.xy, boxSize) + 0.5f * boxSize;
    const float height = pomGetBoxHeight(texture, sampler, boxCenter, level);
    if (level != minMipLevel && curPos.z <=  height) {
      // For mip levels above the minimum, if the curPos is below the max height of the box, just descend a level.
      level = level - 1;
      continue;
    }
    // The axis aligned planes where the ray will exit the box.
    const float2 boxFarCorner = boxCenter + forwardHalfStep * boxSize;

    // The distance to intersect with the x, y, and z planes.
    // origin.x + distance.x * m = bounds.x
    // m = (bounds.x - origin.x) / distance.x
    const float3 intersectDist = (float3(boxFarCorner, height) - origin) / direction;
    const float boundsIntersect = min(intersectDist.x, intersectDist.y);

    // The actual point where the ray exits the box.
    const float3 boxExit = origin + boundsIntersect * direction;

    if (!isOutwardsRay && intersectDist.z <= boundsIntersect)
    {
      // Hit the top of a box with an Inward ray.  
      if (level == 0)
      {
        // When a single texel stretches across multiple on screen pixels, we intersect against a virtual mesh
        // constructed from the height map.
        // The virtual mesh needs to be water tight, and needs to be fully contained by the boxes of each mip
        // level - meaning the max height in a pixel cannot be higher than the actual value of the pixel.  We also
        // want this surface to be smooth, rather than being a series of boxes. Constructing this vitual surface
        // as a quad where each vertex is at a corner of the box, and has a height equal to the minimum of the four
        // surrounding pixels will meet those requirements, but does cut off a single pixel spike, and makes a
        // single pixel pit have a flat bottom.

        // NOTE: I tried improving this algorithm by colliding against a series of 4 triangles, where each triangle 
        // is made of the center pixel value combined with 2 box corners from the above approach.  This unfortunately
        // causes smooth slops to turn jagged. It may be an improvement to use that approach only when the current
        // pixel is the largest or smallest of all the neighbors, but that seemed too complex to be worth pursuing.
        
        // Calculate the point where the ray entered this box:
        const float2 boxNearCorner = boxCenter - forwardHalfStep * boxSize;
        const float2 boxEntranceDist = (boxNearCorner - origin.xy) / direction.xy;
        const float3 boxEntrance = origin + max(0.0f, max(boxEntranceDist.x, boxEntranceDist.y)) * direction;

        const float2 forwardBoxStep = boxSize * forwardStep;
        const float4 corners = pomGetPatchCorners(texture, sampler, boxCenter, forwardBoxStep, height, minMipLevel);
        iterations += 8; // 8 texture lookups for the patch corners, count it as 8 iterations.

        // Normalize the entrance and exit coords to a 0-1 space for lerping.
        const float2 normalEntranceCoord = (boxEntrance.xy - boxNearCorner.xy) / forwardBoxStep;
        const float2 normalExitCoord = (boxExit.xy - boxNearCorner.xy) / forwardBoxStep;

        // We expect one coord of the normalized entrance and exit coords to be 0.  Lerping like this becomes a linear interpolation
        // across the two corners the coord sits between.
        const float entranceHeight = lerp(lerp(corners[0], corners[2], normalEntranceCoord.x), lerp(corners[1], corners[3], normalEntranceCoord.x), normalEntranceCoord.y);
        const float exitHeight = lerp(corners[2], lerp(corners[1], corners[3], normalExitCoord.x), normalExitCoord.y);

        // intersect the ray against that line segment. (2d line intersection works here)
        const float frac = (boxEntrance.z - entranceHeight) / ((exitHeight - entranceHeight) - (boxExit.z - boxEntrance.z));
        const float3 interceptPos = boxEntrance + (boxExit - boxEntrance) * frac;
        
        if (entranceHeight > boxEntrance.z || (frac <= 1 && interceptPos.z <= height && frac >= 0)) {
          // `entranceHeight > boxEntrance.z` return if ray is already under the surface at the near side of the box.
          // `frac <= 1` reject all intersections past the far side of the box.
          // `interceptPos.z <= maxGeoHeight` reject intersections that happen above the highest point of the surface in the box.
          // `frac > 0` reject intersections that happened before the near side of the box.
          return interceptPos;
        }
        // didn't hit the virtual surface, move to next box
      }
      else if (level == minMipLevel)
      {
        // Hit the top of the box at the min mip level, but far enough away that the min mip level is > 0.
        // Use a very simple linear interpolation between prev cell height at entrance, and current cell height at exit to get a collision.
        const float frac = (curPos.z - prevHeight) / ((height - prevHeight) - (boxExit.z - curPos.z));
        return curPos + (boxExit - curPos) * frac;
      }
      else if (level > minMipLevel)
      {
        // Proceed to z intersection and reduce mip.
        curPos = origin + intersectDist.z * direction;
        level = level - 1;
        continue;
      }
    } 
    // intersected with sides of box
    int nextLevel = min( numMipLevels - 1, level + 1);
    // (note, ideally we would just use something like std::nextafterf on boundsIntersect)
    const float3 nextPos = boxExit + direction * min(boxSize.x, boxSize.y) * 0.01f;

    // Maybe don't move up level
    float2 nextBoxSize = pomGetBoxSize(nextLevel, fullBoxSize);
    if (any(pomGetBoxCorner(curPos.xy, nextBoxSize) != pomGetBoxCorner(nextPos.xy, nextBoxSize)))
    {
      level = nextLevel;
    }
    curPos = nextPos;
    prevHeight = height;
  }

  // Outwards rays can go past the top of the POM surface, so limit it to there.
  if (curPos.z > 1)
  {
    float distToOne = (1.0f - origin.z) / direction.z;
    return origin + distToOne * direction;
  }

  return curPos;
}


float pomSampleHeight(uint16_t idx, uint16_t samplerIndex, float2 texcoord)
{
  return 1.0f - textures[nonuniformEXT(uint(idx))].SampleLevel(samplers[nonuniformEXT(uint(samplerIndex))], texcoord, 0).r;
}

float2 pomGetStep(float3 direction, float layerSize, float totalHeight)
{
  // convert tangent space direction to texcoord
  return direction.xy / direction.z * totalHeight * layerSize;
}

float pomGetNumSamples(float3 direction)
{
  const float minSamples = cb.pomMaxIterations / 4.f;
  const float maxSamples = cb.pomMaxIterations;

  // more samples when viewing from oblique angle
  return lerp(maxSamples, minSamples, abs(direction.z));
}

float3 pomCalculateTexcoord(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  SurfaceInteraction surfaceInteraction,
  float3 viewDir,
  inout uint iterations)
{
  float totalHeight = opaqueSurfaceMaterial.displaceIn + opaqueSurfaceMaterial.displaceOut;
  float neutralHeight = opaqueSurfaceMaterial.displaceIn / totalHeight;
  // TODO if the ray origin is below the displaceOut height, bad results happen.
  // need to account for that case.
  float3 direction = -float3(viewDir.xy, viewDir.z / totalHeight);
  if (cb.pomMode == DisplacementMode::RaymarchPOM) {
    float numLayers = pomGetNumSamples(viewDir);
    float layerSize = rcp(numLayers);
    float2 step = pomGetStep(viewDir, layerSize, totalHeight);

    float2 currTexcoord = surfaceInteraction.textureCoordinates;

    currTexcoord = currTexcoord + (step * numLayers * (1.f - neutralHeight));
    float currHeight = pomSampleHeight(opaqueSurfaceMaterial.heightTextureIndex, opaqueSurfaceMaterial.samplerIndex, currTexcoord);

    // raymarch to find intersection
    float currDepth = 0.0f, prevHeight = 0.0f;
    iterations = 0;
    while (currDepth < currHeight)
    {
      iterations++;
      currTexcoord -= step;
      prevHeight = currHeight;
      currHeight = pomSampleHeight(opaqueSurfaceMaterial.heightTextureIndex, opaqueSurfaceMaterial.samplerIndex, currTexcoord);
      currDepth += layerSize;
    }

    // interpolate last two samples to reduce sample aliasing
    float depthNminus1 = prevHeight - currDepth + layerSize;
    float depthN  = currHeight - currDepth;
    float weight = saturate(depthN / (depthN - depthNminus1));
    return float3(currTexcoord + lerp(0..xx, step, weight), currHeight);
  } else if (cb.pomMode == DisplacementMode::QuadtreePOM) {

    return pomTraceRay(
        textures[nonuniformEXT(uint(opaqueSurfaceMaterial.heightTextureIndex))],
        samplers[nonuniformEXT(uint(opaqueSurfaceMaterial.samplerIndex))],
        float3(surfaceInteraction.textureCoordinates, 1.0f),
        direction,
        surfaceInteraction.textureGradientX,
        surfaceInteraction.textureGradientY,
        iterations, neutralHeight);
  }
  return float3(surfaceInteraction.textureCoordinates, 1.f);
}

float pomSampleVisibility(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  float2 texcoord,
  float3 rayDirection)
{
  // Don't actually care about neutral height here - this function just checks if a ray from a texcoord successfully exits
  // the geometry described by the heightmap.  Doesn't (currently) matter how high that geometry is relative to the original surface.
  float totalHeight = opaqueSurfaceMaterial.displaceIn + opaqueSurfaceMaterial.displaceOut;
  // NOTE: pomTraceRay could be used here, but testing found it was more expensive and had worse artifacts when
  // doing visibility testing.
  float2 currTexcoord = texcoord;
  float currHeight = pomSampleHeight(opaqueSurfaceMaterial.heightTextureIndex, opaqueSurfaceMaterial.samplerIndex, currTexcoord);
  float currDepth = currHeight;
  float numLayers = pomGetNumSamples(rayDirection);
  float layerSize = rcp(numLayers);
  float2 step = pomGetStep(rayDirection, layerSize, totalHeight);

  float visibility = 1.0f;
  while (currDepth > 0.0f)
  {
    currTexcoord += step;
    currHeight = pomSampleHeight(opaqueSurfaceMaterial.heightTextureIndex, opaqueSurfaceMaterial.samplerIndex, currTexcoord);
    currDepth -= layerSize;

    if (currHeight < currDepth)
    {
      visibility -= (currDepth - currHeight) / layerSize;
    }
  }

  return saturate(visibility);
}

float opaqueSurfaceMaterialInteractionCalcHeightThroughput(
  MinimalSurfaceInteraction minimalSurfaceInteraction,
  f16vec3 rayDirection,
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  float2 texcoord)
{
  // rebuild tangent space
  const f16mat3 worldToTangent = f16mat3(
    minimalSurfaceInteraction.triangleTangent,
    minimalSurfaceInteraction.triangleBitangent,
    minimalSurfaceInteraction.triangleNormal);
  const f16vec3 lightDirTangentSpace = normalize(mul(worldToTangent, rayDirection));
  return pomSampleVisibility(opaqueSurfaceMaterial, texcoord, lightDirTangentSpace);
}
#endif

SubsurfaceMaterialInteraction subsurfaceMaterialInteractionCreate(
  SubsurfaceMaterial subsurfaceMaterial,
  SurfaceInteraction surfaceInteraction,
  uint16_t samplerIndex)
{
  f16vec4 transmittanceColor = 0.0h;
  f16vec4 subsurfaceMeasurementDistance = 0.0h;
  f16vec4 subsurfaceSingleScatteringAlbedo = 0.0h;

  bool isDiffusionProfile = subsurfaceMaterial.maxSampleRadius > 0.0f;

  bool measurementDistanceLoaded = !isDiffusionProfile ? surfaceMaterialInteractionTextureReadHelper(subsurfaceMaterial.subsurfaceThicknessTextureIndex, samplerIndex, surfaceInteraction, subsurfaceMeasurementDistance) : false;
  bool transmittanceColorLoaded = surfaceMaterialInteractionTextureReadHelper(subsurfaceMaterial.subsurfaceTransmittanceTextureIndex, samplerIndex, surfaceInteraction, transmittanceColor);
  bool singleScatteringAlbedoLoaded = surfaceMaterialInteractionTextureReadHelper(subsurfaceMaterial.subsurfaceSingleScatteringAlbedoTextureIndex, samplerIndex, surfaceInteraction, subsurfaceSingleScatteringAlbedo);

  SubsurfaceMaterialInteraction subsurfaceMaterialInteraction;

  if (measurementDistanceLoaded)
  {
    subsurfaceMaterialInteraction.measurementDistance = subsurfaceMeasurementDistance.r;
  }
  else
  {
    subsurfaceMaterialInteraction.measurementDistance = subsurfaceMaterial.measurementDistance;
  }

  // volumetricAttenuationCoefficient must be read behind measurementDistance, because if using sss textures, the volumetricAttenuationCoefficient need to be calculated base on measurementDistance
  if (transmittanceColorLoaded)
  {
    // Note: It's common to use diffuse albedo color as SSS transmission color, Remix assumes all textures are not using sRGB formats, so we follow the assumption here.
    if (isDiffusionProfile)
    {
      transmittanceColor = gammaToLinear(transmittanceColor);
    }
  }
  else
  {
    if (!isDiffusionProfile) // Thin Opaque
    {
      transmittanceColor.rgb = evalBeerLambertAttenuation(subsurfaceMaterial.volumetricAttenuationCoefficient, subsurfaceMaterial.measurementDistance);
    }
    else // SSS
    {
      transmittanceColor.rgb = subsurfaceMaterial.volumetricAttenuationCoefficient;
    }
  }
  subsurfaceMaterialInteraction.packedTransmittanceColor = colorToR11G11B10(transmittanceColor.rgb);

  if (singleScatteringAlbedoLoaded)
  {
    subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = colorToR11G11B10(subsurfaceSingleScatteringAlbedo.rgb);
  }
  else
  {
    subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = colorToR11G11B10(subsurfaceMaterial.singleScatteringAlbedo);
  }

  subsurfaceMaterialInteraction.volumetricAnisotropy = f16ToSnorm8(subsurfaceMaterial.volumetricAnisotropy);

  subsurfaceMaterialInteraction.maxSampleRadius = subsurfaceMaterial.maxSampleRadius != 0.0h ? f16ToUnorm8(max(subsurfaceMaterial.maxSampleRadius, materialSssEpsilon)) : 0;

  return subsurfaceMaterialInteraction;
}

void storeColorOverlayedWithTextureResolutionCheckersInDebugView(vec3 colorValue, uint textureIndex, SurfaceInteraction surfaceInteraction)
{
  if (textureIndex != BINDING_INDEX_INVALID)
  {
    uint2 texDims;
    textures[nonuniformEXT(uint(textureIndex))].GetDimensions(texDims.x, texDims.y);

    colorValue = 
      tintColorValueWithTextureResolutionCheckers(
        colorValue,
        surfaceInteraction.textureCoordinates,
        surfaceInteraction.textureGradientX * cb.upscaleFactor,
        surfaceInteraction.textureGradientY * cb.upscaleFactor,
        texDims,
        cb.debugKnob.x,
        cb.debugKnob.y);
    storeInDebugView(getDispatchRaysIndex().xy, colorValue);
  }
}

uint8_t calcMipLevelAccessedForSamplerFeedback(SurfaceInteraction surfaceInteraction)
{
  // assume fixed 4k size to report stable accessed mip for differently sized textures
  const uint2 fullBoxSize = uint2(4096, 4096);

  vec2 ddx_tex = surfaceInteraction.textureGradientX * cb.upscaleFactor;
  vec2 ddy_tex = surfaceInteraction.textureGradientY * cb.upscaleFactor;
  ddx_tex *= fullBoxSize;
  ddy_tex *= fullBoxSize;
  const float ddSq = max(dot(ddx_tex, ddx_tex), dot(ddy_tex, ddy_tex));

  return uint8_t(clamp(log2(sqrt(ddSq)), 0, 255));
}

void storeSamplerFeedback(uint32_t samplerFeedbackStamp, SurfaceInteraction surfaceInteraction)
{
  if (samplerFeedbackStamp != SAMPLER_FEEDBACK_INVALID)
  {
    uint32_t oldvalue;
    InterlockedMin(
      SamplerFeedbackBuffer[samplerFeedbackStamp],
      uint32_t(calcMipLevelAccessedForSamplerFeedback(surfaceInteraction)),
      oldvalue);
  }
}

void overrideMaterialInteractionForEye(
  inout OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  const OpaqueSurfaceMaterial            opaqueSurfaceMaterial,
  inout SurfaceInteraction               surfaceInteraction,
  const Surface                          surface,
  const f16vec3                          whitesAlbedo,
  const f16mat3                          worldToTangent,
  const MinimalRayInteraction            minimalRayInteraction,
)
{
  float2 uvIris = eyeCalcIrisUvParallaxed(
    surfaceInteraction.textureCoordinates,
    surface.eyeBasisU,
    surface.eyeBasisV,
    surfaceInteraction.interpolatedNormal,
    worldToTangent,
    minimalRayInteraction.viewDirection,
    cb.eyeArgs.irisRadius,
    cb.eyeArgs.irisDepth
  );

  bool    irisLoaded;
  f16vec4 irisSample;
  {
    // 'surfaceMaterialInteractionTextureReadHelper' requires 'surfaceInteraction.textureCoordinates'
    vec2 savedCoordinates = surfaceInteraction.textureCoordinates;
    // so set iris UV temporarily
    surfaceInteraction.textureCoordinates = uvIris;
    irisLoaded                            = surfaceMaterialInteractionTextureReadHelper(
      opaqueSurfaceMaterial.secondaryTextureIndex,
      opaqueSurfaceMaterial.samplerIndex,
      surfaceInteraction,
      irisSample
    );
    // and revert UV back
    surfaceInteraction.textureCoordinates = savedCoordinates;
  }

  if (!irisLoaded)
  {
    return;
  }

  // Note: Gamma correct albedo input (be it from a constant or a texture). Currently assuming all textures are not using sRGB formats which
  // automatically do this conversion.
  // Todo: Disable this for when a sRGB texture is the source of the albedo.
  irisSample.rgb = gammaToLinear(irisSample.rgb);

  // blend between whites and iris
  f16vec3 eyeAlbedo = mix(
    saturate(whitesAlbedo * cb.eyeArgs.whitesAlbedoScale),
    irisSample.rgb,
    irisSample.a // 0 (transparent) - whites, 1 (opaque) - iris
  );
  // NOTE: eye redness can be added here, if a game can provide such data

  const float16_t eyeRoughness  = 0.h;
  const float16_t eyeMetallic   = 0.h;
  const float16_t eyeOpacity    = 1.h;
  const float16_t eyeAnisotropy = 0.h;
  calcRoughness(
    eyeRoughness,
    eyeAnisotropy,
    opaqueSurfaceMaterialInteraction.isotropicRoughness,
    opaqueSurfaceMaterialInteraction.anisotropicRoughness
  );
  opaqueSurfaceMaterialInteraction.albedo           = albedoToAdjustedAlbedo(eyeAlbedo, eyeMetallic, eyeOpacity);
  opaqueSurfaceMaterialInteraction.baseReflectivity = calcBaseReflectivity(eyeAlbedo, eyeMetallic, eyeOpacity);
  opaqueSurfaceMaterialInteraction.opacity          = eyeOpacity;

  opaqueSurfaceMaterialInteraction.emissiveRadiance =
    irisSample.rgb * irisSample.a *
    opaqueSurfaceMaterial.emissiveIntensity;
}

// NV-DXVK: per-pixel scene dump helper (extracted out-of-line). Inlining
// the GetDimensions + Jacobian SVD + structured-buffer store sequence
// triggers an internal slangc access violation on the
// gbuffer_nrc_material_opaque_translucent_closestHit variant (no
// diagnostic, exit code -1073741819). Same workaround pattern as the
// computeFragmentDdxDdyPerspective extraction documented in
// surface_interaction.slangh — keeping the heavy math in its own function
// partitions slang's optimizer IR enough to keep it from crashing.
//
// Writes one SceneDumpElement to SceneDumpBuffer at
// (pixel.y * cb.sceneDumpStride + pixel.x). Caller must gate on
// cb.sceneDumpEnabled — this function performs the write unconditionally.
void writeSceneDumpEntry(
  vec2 hitUv,
  vec2 ddx,
  vec2 ddy,
  uint texIdxArg,
  uint pathCodeArg,
  vec2 lightmapUv,
  bool surfaceHasLightmap,
  // NV-DXVK [VanishDiag-Shader]: clip.w spread + world hit position so
  // CSV consumers can correlate pathCode=1 pixels with the actual
  // surface position and the perspective math's input range.
  float minClipW,
  float maxClipW,
  vec3  hitWorld)
{
#if defined(RAY_TRACING_PRIMARY_RAY)
  uint2 texDims = uint2(0u, 0u);
  if (texIdxArg != BINDING_INDEX_INVALID)
  {
    textures[nonuniformEXT(texIdxArg)].GetDimensions(texDims.x, texDims.y);
  }

  // Jacobian SVD — same closed form used by probe slot 14 for the
  // path-checker readback; minor axis is what HW uses for mip selection
  // when the aniso ratio fits inside aniMax.
  const float gx_u = ddx.x;
  const float gx_v = ddx.y;
  const float gy_u = ddy.x;
  const float gy_v = ddy.y;
  const float T = gx_u * gx_u + gx_v * gx_v + gy_u * gy_u + gy_v * gy_v;
  const float dJ = gx_u * gy_v - gx_v * gy_u;
  const float discr = max(T * T - 4.0f * (dJ * dJ), 0.0f);
  const float root = sqrt(discr);
  const float minor = sqrt(max((T - root) * 0.5f, 0.0f));
  const float major = sqrt(max((T + root) * 0.5f, 0.0f));
  const float aniso = major / max(minor, 1e-20f);
  const float texDim = float(max(max(texDims.x, texDims.y), 1u));
  const float kAniMax = 16.0f;
  const float effective = (aniso <= kAniMax) ? minor : (major / kAniMax);
  const float mipLevel = log2(max(effective * texDim, 1.0f));

  SceneDumpElement entry;
  entry.u = hitUv.x;
  entry.v = hitUv.y;
  entry.mip = mipLevel;
  entry.aniso = aniso;
  entry.texIdx = texIdxArg;
  entry.texDimsPacked = (min(texDims.x, 0xFFFFu) << 16) | min(texDims.y, 0xFFFFu);
  entry.pathCode = pathCodeArg;
  // bit 0 = hit valid, bit 1 = surface had its hasLightmap flag set
  // (TEXCOORD1 was decoded and interpolated; lightmapUv is real).
  entry.flags = 1u | (surfaceHasLightmap ? 2u : 0u);
  entry.lightmapU = lightmapUv.x;
  entry.lightmapV = lightmapUv.y;
  entry.minClipW = minClipW;
  entry.maxClipW = maxClipW;
  entry.hitWorldX = hitWorld.x;
  entry.hitWorldY = hitWorld.y;
  entry.hitWorldZ = hitWorld.z;

  const uint2 pix = getDispatchRaysIndex().xy;
  const uint outIdx = pix.y * cb.sceneDumpStride + pix.x;
  SceneDumpBuffer[outIdx] = entry;
#endif
}

// Opaque Surface Material Interaction Functions

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(
  OpaqueSurfaceMaterial opaqueSurfaceMaterial,
  Surface surface,
  inout SurfaceInteraction surfaceInteraction,
  MinimalRayInteraction minimalRayInteraction,
  // NV-DXVK [Coverage]: surfaceIndex of this hit, used only by the
  // SurfaceCoverageBuffer InterlockedAdd at the end of this function under
  // #ifdef RAY_TRACING_PRIMARY_RAY. Passed through unconditionally so the
  // signature doesn't bifurcate; non-primary callers pay zero cost because
  // the only consumer is gated out.
  uint inCovSurfaceIndex,
  // NV-DXVK [Coverage]: per-call-site ID for the high-surfaceIndex probe.
  // We see surfaceIndex >> orderedSize values in coverage dumps that should
  // be impossible if surfaceMapping[] is correctly translating prev-frame
  // indices in the visibility path. Tagging each caller lets the readback
  // attribute "out-of-range" hits to the call site producing them — that
  // identifies the path bypassing the mapping (or proves it's the mapping
  // itself returning bad values). Site IDs documented at each caller.
  uint inCovCallSiteId)
{
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;
  // Note: need initialize the flags explicitely to get rid of garbage data.
  opaqueSurfaceMaterialInteraction.flags = 0;

  // Create a tangent to world space matrix for future calculations

  const f16mat3 worldToTangent = f16mat3(surfaceInteraction.interpolatedTangent, surfaceInteraction.interpolatedBitangent, surfaceInteraction.interpolatedNormal);

  // Note: Does not represent if the thin film is enabled in all cases, such as if the thin film enable override is specified, merely concerned with if
  // it has been directly enabled by the material itself.
  // NV-DXVK [Perf.SubLadder]: thin film is one of the two features whose removal
  // took the gbuffer shader from 255 to 168 registers and bought 22% (the other
  // is POM). That result was recorded as confounded because it removed execution
  // work as well as registers. Occupancy has since been refuted directly - rung 4
  // of the compile-time ladder runs at 168 registers vs 255 for the full shader
  // (12 warps vs 8) in identical time - so the 22% was the execution work alone.
  // That makes thin film and POM the two named candidates inside the 74.5 ms, and
  // this flag isolates thin film on its own.
  const bool thinFilmEnabled = (cb.perfSkipThinFilm == 0) &&
    (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_USE_THIN_FILM_LAYER);

  opaqueSurfaceMaterialInteraction.flags |= thinFilmEnabled ? OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_USE_THIN_FILM_LAYER : 0;

#ifdef OPAQUE_MATERIAL_USE_POM
  // NV-DXVK [Perf.SubLadder]: perfSkipPom isolates the POM raymarch. Worth
  // measuring even if TF2 has no displacement maps - if the cost is zero here,
  // that is itself the answer, and it removes the more expensive of the two
  // POM+thin-film features from the 22% attribution above.
  if (cb.perfSkipPom == 0 && cb.pomMode != DisplacementMode::Off && opaqueSurfaceMaterial.hasValidDisplacement())
  {
    const mat3 worldToTexture = inverse(transpose(mat3(surfaceInteraction.rawTangent, surfaceInteraction.rawBitangent, surfaceInteraction.interpolatedNormal)));
    // TextureGradient x might be along the same direction as the view ray?  make a debug view that shows the dot product between textureGradient.x and viewDirTangentSpace?

    f16vec3 viewDirTextureSpace = normalize(mul(worldToTexture, minimalRayInteraction.viewDirection));
    // Note: -1.f * TextureGradientX has the same x,y direction as viewDirTextureSpace, but calculating the correct z value is non-obvious.
    // Could potentially remove the need for the worldToTexture transform if a faster way to calculate that z value is found.
    
    uint iterations = 0; // unused
    const vec2 pomTextureCoordinates = pomCalculateTexcoord(
        opaqueSurfaceMaterial,
        surfaceInteraction,
        viewDirTextureSpace,
        iterations).xy;

    // WAR for REMIX-3709 - POM sometimes produces NaNs.
    surfaceInteraction.textureCoordinates = sanitize(pomTextureCoordinates, surfaceInteraction.textureCoordinates);

    opaqueSurfaceMaterialInteraction.flags |= OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_HAS_HEIGHT_TEXTURE;
  }
#endif

  // Sample from each Opaque Surface Material texture

  f16vec4 albedoOpacitySample;
  f16vec4 normalSample;
  f16vec4 secondNormalSample;
  f16vec4 tangentSample;
  f16vec4 roughnessSample;
  f16vec4 metallicSample;
  f16vec4 emissiveColorSample;

  // NV-DXVK [Perf.SubLadder]: drivesControlFlow=true. The opacity in this sample
  // decides continueResolving, so rtx.perfSkipMaterialTextures must NOT suppress
  // it - otherwise the probe changes how many resolve iterations run and stops
  // measuring texture cost. Every other read below is suppressible.
  const bool albedoOpacityLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.albedoOpacityTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, albedoOpacitySample, 0.0, true);
  bool normalLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.normalTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, normalSample);

  bool secondNormalLoaded = false;
  if (cb.opaqueMaterialArgs.layeredWaterNormalEnable && surface.isAnimatedWater)
  {
    // take a second sample from a higher LOD using a modified texture xform
    const vec2 motionScale = vec2(cb.opaqueMaterialArgs.layeredWaterNormalMotionX, cb.opaqueMaterialArgs.layeredWaterNormalMotionY) * cb.opaqueMaterialArgs.layeredWaterNormalMotionScale;
    const float lodBias = cb.opaqueMaterialArgs.layeredWaterNormalLodBias;

    mat4x2 xform = surface.textureTransform;
    xform[0][2] *= motionScale.x;
    xform[1][2] *= motionScale.y;

    vec2 savedCoordinates = surfaceInteraction.textureCoordinates;
    surfaceInteraction.textureCoordinates = mul(xform, float4(surfaceInteraction.textureCoordinates, 0.f, 1.f)).xy;
    secondNormalLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.normalTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, secondNormalSample, lodBias);
    surfaceInteraction.textureCoordinates = savedCoordinates;
  }

  const bool tangentLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.tangentTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, tangentSample);
  const bool roughnessLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.roughnessTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, roughnessSample);
  const bool metallicLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.metallicTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, metallicSample);
  // NV-DXVK: TF2 viewmodel "screen-space scrolling overlay" emissive — when
  // the OPAQUE_SURFACE_MATERIAL_FLAG_HAS_SCREEN_SPACE_EMISSIVE flag is set,
  // sample the emissive texture at a UV derived from SV_Position transformed
  // by the per-material 2x2 matrix + translate, rather than at mesh UV. The
  // sample is then optionally multiplied by a mask sampled at mesh UV.
  // Reproduces the gun screen "blue lines" from PS 0x7836c1dd4d5c885f /
  // 0xea2b85b0f20fddf3 (asm lines 280-296). Falls back to mesh-UV sampling
  // for every other material.
  bool emissiveColorLoaded;
  if ((opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_HAS_SCREEN_SPACE_EMISSIVE) != 0)
  {
    // NV-DXVK DEBUG: set kSseDebugForceRed=1 to flood the gun with red on
    // any pixel that enters the screen-space emissive branch. Tells us
    // whether the flag bit is propagating from CPU to GPU. Set back to 0
    // once the branch is confirmed firing on the gun screen.
    // (Confirmed firing on the holo guide character; turning off so
    //  the actual screen-space sampling path runs for both gun + holo.)
    static const uint kSseDebugForceRed = 0;
    if (kSseDebugForceRed != 0u)
    {
      emissiveColorSample = f16vec4(1.0h, 0.0h, 0.0h, 1.0h);
      emissiveColorLoaded = true;
    }
    else {
    SurfaceInteraction screenSpaceEmissiveSurfaceInteraction = surfaceInteraction;
    // pixelCoord × c_rcpRenderTargetSize → screen UV in [0, 1].
    const vec2 pixelCoord = vec2(getDispatchRaysIndex().xy);
    const vec2 rcpRtSize  = vec2(1.0f) / vec2(cb.camera.resolution);
    const vec2 screenUv   = pixelCoord * rcpRtSize;

    // NV-DXVK [ScreenSpaceEmissive.SlangProbe]: write the value of
    // `cb.screenSpaceEmissiveTime` that this slang invocation actually
    // sees into a dedicated GpuPrintBuffer slot, so the C++ side can read
    // it back and confirm the constant uploaded by RtxContext matches
    // what the GPU shader observed. Slot 4 (= kMaxFramesInFlight) is
    // outside the per-frame ring used by the existing slot probes, so
    // there's no collision. Multiple ray threads on the holo character
    // race on this write but write the same value (cb is per-frame
    // constant) — benign. Tagged with sentinel 999.0 in `.w` so the
    // C++ readback can distinguish it from any other writer that
    // accidentally lands on this slot.
    {
      static const uint kSseDebugProbeSlot = 4u;
      GpuPrintBufferElement sseProbe;
      sseProbe.threadIndex = u16vec2(getDispatchRaysIndex().xy);
      sseProbe.frameIndex  = cb.frameIdx;
      sseProbe.writtenData = float4(
        cb.screenSpaceEmissiveTime,
        float(cb.frameIdx),
        float(getDispatchRaysIndex().x) + float(getDispatchRaysIndex().y) * 65536.0f,
        999.0f);
      GpuPrintBuffer[kSseDebugProbeSlot] = sseProbe;
    }
    // Emissive texture UV = M × screenUv + T × animScalar.
    // animScalar in the original PS is cb2[18].w (= CBufCommonPerCamera
    // c_gameTime, gameplay-seconds since map start, freezes during pause).
    // d3d11_rtx.cpp::FillMaterialData captures this from any
    // screen-space-emissive draw and stashes it on SceneManager;
    // RtxContext plumbs it into RaytraceArgs.screenSpaceEmissiveTime each
    // frame. With t=0 (before any such draw fires) the translate has zero
    // effect, matching native at game-time-zero. The texture sampler
    // wraps so large UV magnitudes (translate.y=8 × t=many seconds) just
    // tile into the same 0..1 range each frame.
    const float animScalar = cb.screenSpaceEmissiveTime;
    const vec2 row0 = vec2(opaqueSurfaceMaterial.screenSpaceEmissiveMatRow0);
    const vec2 row1 = vec2(opaqueSurfaceMaterial.screenSpaceEmissiveMatRow1);
    const vec2 trsl = vec2(opaqueSurfaceMaterial.screenSpaceEmissiveTranslate);
    const vec2 emissiveTexUv = vec2(
      dot(screenUv, row0) + trsl.x * animScalar,
      dot(screenUv, row1) + trsl.y * animScalar);
    screenSpaceEmissiveSurfaceInteraction.textureCoordinates = emissiveTexUv;
    // Zero out the gradients so the helper picks mip 0 — the original PS
    // uses sample_indexable (no LOD), and screen-aligned content has no
    // meaningful surface-derived gradient anyway.
    screenSpaceEmissiveSurfaceInteraction.textureGradientX = vec2(0.0f);
    screenSpaceEmissiveSurfaceInteraction.textureGradientY = vec2(0.0f);
    emissiveColorLoaded = surfaceMaterialInteractionTextureReadHelper(
      opaqueSurfaceMaterial.emissiveColorTextureIndex,
      opaqueSurfaceMaterial.samplerIndex,
      screenSpaceEmissiveSurfaceInteraction, emissiveColorSample);
    // Optional mask: if a mask texture index was wired in, sample it at the
    // mesh UV and multiply the emissive sample by it (matches the asm's
    // `mul r4.xyz, r4.xyzx, r5.xyzx` after sampling t17 at mesh UV).
    if (emissiveColorLoaded
        && opaqueSurfaceMaterial.screenSpaceEmissiveMaskTextureIndex != BINDING_INDEX_INVALID)
    {
      f16vec4 maskSample;
      const bool maskLoaded = surfaceMaterialInteractionTextureReadHelper(
        opaqueSurfaceMaterial.screenSpaceEmissiveMaskTextureIndex,
        opaqueSurfaceMaterial.samplerIndex,
        surfaceInteraction, maskSample);
      if (maskLoaded)
      {
        emissiveColorSample.rgb *= maskSample.rgb;
      }
    }
    }  // close kSseDebugForceRed else
  }
  else
  {
    emissiveColorLoaded = surfaceMaterialInteractionTextureReadHelper(opaqueSurfaceMaterial.emissiveColorTextureIndex, opaqueSurfaceMaterial.samplerIndex, surfaceInteraction, emissiveColorSample);
  }
  
  // NV-DXVK: TF2 aux textures.
  //   lightmap + lightmap2: additive into emissive, sampled at TEXCOORD1
  //     (lightmap UV) which lives in surfaceInteraction.lightmapTextureCoordinates.
  //     The interleaver decoded that stream from R32G32_UINT via
  //     `* 1/65535` (matching VS_e7abcf4e's body); surface_interaction
  //     interpolated per-hit.  Pre-fix, both lightmaps sampled at the
  //     albedo UV, which produced random nearby lightmap-atlas pixels and
  //     visually broken lighting on every BSP wall.
  //   detail + cloudMask: multiplicative into albedo, sampled at TEXCOORD0
  //     (albedo UV) like before.
  // Each read is a no-op when the corresponding texture index is invalid.
  // Build a temporary SurfaceInteraction for the lightmap reads so the
  // helper picks up the right UV without changing its public API. Gradients
  // are inherited from the albedo path — adequate for lightmaps because
  // their per-face atlas slot is small and HW LOD picks mip 0 regardless;
  // a future refinement could compute a lightmap-specific Jacobian.
  SurfaceInteraction lightmapSurfaceInteraction = surfaceInteraction;
  lightmapSurfaceInteraction.textureCoordinates = surfaceInteraction.lightmapTextureCoordinates;
  f16vec4 lightmapSample;
  const bool lightmapLoaded = surfaceMaterialInteractionTextureReadHelper(
    opaqueSurfaceMaterial.lightmapTextureIndex,
    opaqueSurfaceMaterial.samplerIndex,
    lightmapSurfaceInteraction, lightmapSample);
  f16vec4 lightmap2Sample;
  const bool lightmap2Loaded = surfaceMaterialInteractionTextureReadHelper(
    opaqueSurfaceMaterial.lightmap2TextureIndex,
    opaqueSurfaceMaterial.samplerIndex,
    lightmapSurfaceInteraction, lightmap2Sample);
  f16vec4 detailSample;
  const bool detailLoaded = surfaceMaterialInteractionTextureReadHelper(
    opaqueSurfaceMaterial.detailTextureIndex,
    opaqueSurfaceMaterial.samplerIndex,
    surfaceInteraction, detailSample);
  // NV-DXVK: cloudMask compositing disabled — it produced visible streaks
  // across walls / ceilings because we don't have the game's camera-relative
  // projection cbuffer constants (cb2[30/31] in FS_ac8c6ae6). Re-enable
  // only after wiring in the real world-space projection or accepting a
  // tunable hack.
  f16vec4 cloudMaskSample = f16vec4(1.0h);
  const bool cloudMaskLoaded = false;

  // Load Emissive Color

  f16vec3 emissiveColor = opaqueSurfaceMaterial.emissiveColorConstant;

  if (emissiveColorLoaded)
  {
    // NV-DXVK: when the OPAQUE_SURFACE_MATERIAL_FLAG_EMISSIVE_TINT_FROM_CONSTANT
    // flag is set, emissiveColorConstant is a per-draw c_emissiveTint that
    // must MULTIPLY the per-pixel sample, matching the original PS's
    // `emissive = sample * c_emissiveTint`. Otherwise (legacy default,
    // emissiveColorConstant is a no-texture fallback only) the sample
    // overwrites the constant as before.
    if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_EMISSIVE_TINT_FROM_CONSTANT)
    {
      emissiveColor = emissiveColorSample.xyz * opaqueSurfaceMaterial.emissiveColorConstant;
    }
    else
    {
      emissiveColor = emissiveColorSample.xyz;
    }
  }

  // NV-DXVK: additively fold baked lightmap samples into the emissive
  // channel. This gives TF2 BSP faces their static GI appearance without
  // requiring real-time lights — surfaces "emit" the light the map-baker
  // intended, and Remix's BSDF / path tracer handles bounces from there.
  // lightmap2 is the bumped / HDR range-extension lightmap; both are added
  // equally at low weight so they compose without blowing out.
  if (lightmapLoaded)
  {
    emissiveColor += lightmapSample.rgb;
  }
  if (lightmap2Loaded)
  {
    emissiveColor += lightmap2Sample.rgb;
  }
  
  // Load Albedo/Opacity

  f16vec3 albedo = opaqueSurfaceMaterial.albedoOpacityConstant.rgb;
  float16_t opacity = opaqueSurfaceMaterial.albedoOpacityConstant.a;
  float16_t emissiveBlendOverrideInfluence = float16_t(1.0f);
  float16_t thinFilmThickness = float16_t(0.0f);

  // Baked terrain is the only surface using cascaded view positions, so key off of that
  const bool isBakedTerrain = surface.texcoordGenerationMode == uint(TexGenMode::CascadedViewPositions);

  // Texture operations have already been applied during terrain baking, so skip them for baked terrain surfaces
  const bool applyTextureOperations = !isBakedTerrain;

  // Note: Set thin film thickness constant fallback only if the thin film is enabled as a non-zero value here is responsible for indicating
  // if the thin film is in use by later code.
  if (thinFilmEnabled)
  {
    thinFilmThickness = opaqueSurfaceMaterial.thinFilmThicknessConstant;
  }

  // NV-DXVK: sample cavity / baked-AO map if bound, and modulate albedo by
  // its red channel. Matches native PS semantics for TF2 BSP (FS_ac8c6ae6 does
  // `color *= cavity.r`) and any other material whose PS RDEF names a
  // cavityTexture / aoTexture / ambientOcclusionTexture. No-op when the
  // texture index is invalid.
  f16vec4 ambientOcclusionSample;
  const bool ambientOcclusionLoaded = surfaceMaterialInteractionTextureReadHelper(
    opaqueSurfaceMaterial.ambientOcclusionTextureIndex,
    opaqueSurfaceMaterial.samplerIndex,
    surfaceInteraction,
    ambientOcclusionSample);

  // NV-DXVK: if this material has cavity but no real normal map (common for
  // TF2 BSP walls — FS_ac8c6ae6 has NO normalTexture binding), synthesise a
  // tangent-space normal via Sobel of the cavity height. Two extra SampleLevel
  // calls per primary hit: (u+du, v) and (u, v+du). The partial derivatives
  // form the xy of a tangent-space normal; z = 1 gives a unit normal scaled
  // by `kHeightStrength`. Stamped into normalSample in the standard
  // (0.5 + 0.5*n) encoding the downstream normal-decode path expects.
  if (ambientOcclusionLoaded && !normalLoaded)
  {
    const uint aoTexIdx = uint(opaqueSurfaceMaterial.ambientOcclusionTextureIndex);
    const uint aoSampIdx = uint(opaqueSurfaceMaterial.samplerIndex);
    // One-texel-ish step; the cavity textures we see are typically 256–512
    // wide, so 1/256 gives a roughly 1-texel offset regardless of wrap.
    const float dStep = 1.0f / 256.0f;
    const vec2 uvC = surfaceInteraction.textureCoordinates;
    const float hC = float(ambientOcclusionSample.r);
    const float hDu = textures[nonuniformEXT(aoTexIdx)]
      .SampleLevel(samplers[nonuniformEXT(aoSampIdx)], uvC + vec2(dStep, 0.0f), 0).r;
    const float hDv = textures[nonuniformEXT(aoTexIdx)]
      .SampleLevel(samplers[nonuniformEXT(aoSampIdx)], uvC + vec2(0.0f, dStep), 0).r;
    // kHeightStrength controls how pronounced the panel-edge shading is.
    // 4.0 gives visible panel highlights without looking plasticy — tune
    // per-material via a future OpaqueMaterialData option.
    const float kHeightStrength = 4.0f;
    const vec3 synthTangentNormal = normalize(vec3(
      (hC - hDu) * kHeightStrength,
      (hC - hDv) * kHeightStrength,
      1.0f));
    // Encode (0.5 + 0.5 * n) — matches the convention the existing
    // normal-sample decode path assumes for tangent-space normals.
    normalSample = f16vec4(f16vec3(synthTangentNormal * 0.5f + 0.5f), 1.0h);
    normalLoaded = true;
  }

  if (albedoOpacityLoaded)
  {
    albedo = albedoOpacitySample.rgb;
    if (ambientOcclusionLoaded)
    {
      albedo *= ambientOcclusionSample.rrr;
    }
    // Multiplicative detail overlay (fine-scale brick/panel variation).
    // Detail textures are typically encoded around 0.5 gray; lerp so a
    // mid-gray sample = no change, brighter/darker texels nudge albedo
    // around the identity.
    if (detailLoaded && !cb.disableDetailOverlay)
    {
      albedo *= detailSample.rgb * f16vec3(2.0h);
    }
    // Large-scale tonal banding (cloudmask in the TF2 BSP PS).
    if (cloudMaskLoaded)
    {
      albedo *= cloudMaskSample.rrr;
    }

    // Note: Thin film thickness and opacity deriving their values from the alpha channel are mutually exclusive, set the appropriate
    // one based on the specified flags, and set the opposing variable to a default value (the "default" value must match how the material is decoded from the
    // GBuffer as well). Ideally we'd want to simply fall back on the existing opacity/thin film thickness constants instead, but we currently do not have a
    // way of encoding these values in the GBuffer, so a code constant must be used instead. Finally, thinFilmEnabled does not need to be checked here as the
    // alpha as thin film thickness flag is only set on the CPU if the use thin film flag is true.
    // Also, the alpha channel of the texture should always be linear even if it is using a sRGB encoding (as the alpha channel in such encodings remains linear),
    // so no special compensation has to be done here (unlike the albedo which may need to have software gamma correction skipped when reading from sRGB textures).
    if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALPHA_IS_THIN_FILM_THICKNESS)
    {
      thinFilmThickness = albedoOpacitySample.a;
      opacity = float16_t(1.0f);
    }
    else
    {
      opacity = albedoOpacitySample.a;
      thinFilmThickness = float16_t(0.0f);
    }

    // [CloudPremultProbe] Diagnostic - frame-aggregate, NO mouse aiming.
    // For ANY translucent soft-edge texel anywhere on screen (mid-range
    // alpha), write the RAW sampled albedo luminance / alpha / ratio into
    // the gpuPrint ring slot. Many texels race; last writer per frame wins,
    // which is fine - premultiplied-vs-straight is a uniform property of the
    // texture, so any single cloud-edge texel answers it. The user just
    // needs clouds visible somewhere; no precise hovering, immune to low FPS.
    //   premultiplied -> rgb scaled by coverage  -> lum/alpha ~<= 1
    //   straight alpha -> rgb full-bright at low coverage -> lum/alpha >> 1
    // Tag 20.0 in .w; decoded CPU-side in rtx_context.cpp. Gated to soft
    // translucent texels and to gpuPrint being enabled (gpuPrintThreadIndex
    // is kInvalidThreadIndex when disabled).
    if (cb.gpuPrintThreadIndex.x != kInvalidThreadIndex
        && opacity > float16_t(0.04) && opacity < float16_t(0.75))
    {
      const float16_t probeLum = calcBt709Luminance(albedoOpacitySample.rgb);
      const float probeAlpha = float(albedoOpacitySample.a);
      const float probeRatio = float(probeLum) / max(probeAlpha, 1e-4f);
      GpuPrintBufferElement cloudProbe;
      cloudProbe.threadIndex = u16vec2(getDispatchRaysIndex().xy);
      cloudProbe.frameIndex  = cb.frameIdx;
      cloudProbe.writtenData = float4(float(probeLum), probeAlpha, probeRatio, 20.0f);
      GpuPrintBuffer[cb.gpuPrintElementIndex] = cloudProbe;
    }
  }

#if defined(RAY_TRACING_PRIMARY_RAY)
  // NV-DXVK DEBUG: per-path-code colorization, gated on the dedicated
  // DEBUG_VIEW_GRADIENT_PATH_CHECKER view so normal rendering is
  // unaffected. A UV-space, analytically box-filtered checker is
  // multiplied into the color so a wall whose UVs are stretched along one
  // axis renders cells visibly squashed along that axis — that squash IS
  // the diagnostic for UV stretching.
  //   0   perspective ok        → GREEN (0,1,0)
  //   1   clip.w<=1              → ORANGE (1,0.5,0)
  //   2   det<=1                 → YELLOW (1,1,0)
  //   3   interpInvW degenerate  → CYAN (0,1,1)
  //   4   cap fired (>64)        → RED (1,0,0)
  //   5   NaN/Inf                → MAGENTA (1,0,1)
  //   10  1D fallback            → BLUE (0,0,1)
  //   255 unset                  → DARK PURPLE — hit ran but no pathCode set
  //   any other                  → WHITE       — unexpected pathCode
  if (cb.debugView == DEBUG_VIEW_GRADIENT_PATH_CHECKER)
  {
    // NV-DXVK DIAG: every opaque hit gets a path color now (no early-exit
    // for the default case). 255 → PURPLE means "hit shader ran but
    // debugPathCode was never written" (i.e. computeAnisotropicEllipseAxes
    // didn't run / didn't propagate). Anything else not in the legend →
    // BRIGHT WHITE so it's instantly obvious. This is how we tell visually
    // whether the path-code wiring is firing at all when the user can't
    // run the GpuPrint mouse probe.
    f16vec3 pathColor;
    // NV-DXVK [perf]: with REMIX_SI_DEBUG_FIELDS off the path code is not
    // carried per-pixel, so this view has nothing to colorize. Fall through to
    // the "unset" colour rather than failing to compile - re-enable the flag to
    // use the view.
#if REMIX_SI_DEBUG_FIELDS
    switch (surfaceInteraction.debugPathCode)
#else
    switch (255u)
#endif
    {
      case 0u:   pathColor = f16vec3(0.0h, 1.0h, 0.0h); break;  // perspective ok → GREEN
      case 1u:   pathColor = f16vec3(1.0h, 0.5h, 0.0h); break;  // clip.w<=1     → ORANGE
      case 2u:   pathColor = f16vec3(1.0h, 1.0h, 0.0h); break;  // det<=1        → YELLOW
      case 3u:   pathColor = f16vec3(0.0h, 1.0h, 1.0h); break;  // interpInvW    → CYAN
      case 4u:   pathColor = f16vec3(1.0h, 0.0h, 0.0h); break;  // cap fired     → RED
      case 5u:   pathColor = f16vec3(1.0h, 0.0h, 1.0h); break;  // NaN/Inf       → MAGENTA
      case 10u:  pathColor = f16vec3(0.0h, 0.0h, 1.0h); break;  // 1D fallback   → BLUE
      case 255u: pathColor = f16vec3(0.5h, 0.0h, 0.5h); break;  // unset         → DARK PURPLE
      default:   pathColor = f16vec3(1.0h, 1.0h, 1.0h); break;  // unexpected    → WHITE
    }
    // UV-space hard 0/1 checker — colored cells keep the full path color,
    // off cells are pure black. Cells follow surfaceInteraction.textureCoordinates,
    // so on a wall with stretched UVs the cells visibly elongate along the
    // stretch axis. Aliasing of cells past the per-pixel UV gradient is
    // itself a stretch indicator. cb.debugKnob.x > 0 overrides the default
    // (0.0625 = 1 cell per 16 UV units) live.
    float checkerShadeForLog;
    {
      // 0.05 = one cell per 20 UV units. TF2 BSP UVs run 100s–1000s
      // (uvLen ~1500 on the strips we measured), so this yields ~50-75
      // cells across a typical wall — coarse enough to actually SEE as
      // boxes per-pixel rather than aliasing into Moiré. Stretched UVs
      // produce visibly elongated cells along the stretch axis. Tune
      // live via cb.debugKnob.x (any value > 0 overrides). Bump to 0.5
      // or 1.0 for fine grid, drop to 0.005 for huge tiles.
      const float kDefaultCellsPerUnit = 0.05f;
      const float cellsPerUnit = cb.debugKnob.x > 0.0f
        ? cb.debugKnob.x : kDefaultCellsPerUnit;
      const vec2 uv = surfaceInteraction.textureCoordinates;
      const ivec2 cellIdx = ivec2(floor(uv * cellsPerUnit));
      const bool cellOn = ((cellIdx.x + cellIdx.y) & 1) == 0;
      const float16_t shade = cellOn ? float16_t(1.0h) : float16_t(0.0h);
      albedo = pathColor * shade;
      checkerShadeForLog = float(shade);
    }

    // NV-DXVK DIAG: per-pixel probe surfaced to the CPU as a
    // [PathCheckerProbe] log line every frame the user is on view 52.
    // CPU side auto-anchors gpuPrintThreadIndex to the screen-centre pixel
    // when on view 52. Two packet types alternate by frame parity so the
    // CPU log emits both dim/mipCount and texIdx/sampledMip lines:
    //
    //   EVEN frame (sentinel x = pathCode, in 0..253):
    //     x: pathCode       (0..10 / 253 = no albedo bound)
    //     y: bound albedoW
    //     z: bound albedoH
    //     w: bound albedoMipCount
    //
    //   ODD frame (sentinel x = 254 — DIM/MIP packet identifier):
    //     x: 254 (sentinel, distinguishes the packet type on CPU)
    //     y: opaqueSurfaceMaterial.albedoOpacityTextureIndex
    //     z: computed sampled-mip (isotropic, log2(maxGrad*texDim))
    //     w: mipCount of bound albedo
    {
      uint albedoW = 0;
      uint albedoH = 0;
      uint albedoMipCount = 0;
#if REMIX_SI_DEBUG_FIELDS
      uint pathCodeOut = uint(surfaceInteraction.debugPathCode);
#else
      uint pathCodeOut = 255u;
#endif
      uint texIdx = uint(opaqueSurfaceMaterial.albedoOpacityTextureIndex);
      if (texIdx != BINDING_INDEX_INVALID)
      {
        textures[nonuniformEXT(texIdx)].GetDimensions(0, albedoW, albedoH, albedoMipCount);
      }
      else
      {
        pathCodeOut = 253u;  // distinct from "unset" (255) and alt-packet (254)
      }

      // Aniso-aware mip — matches HW behaviour: sampler picks the mip
      // along the MINOR axis, then takes up to aniMax taps along the
      // major axis. When aniso > aniMax, the mip is forced higher
      // (= log2(major / aniMax)). When aniso <= aniMax, mip = log2(minor).
      // Closed form:  mip = log2( max(minor, major / aniMax) ).
      const float aniMax = 16.0f;  // matches native sampler aniMax=16
      const vec2 dim = vec2(float(albedoW), float(albedoH));
      const vec2 gx = surfaceInteraction.textureGradientX * cb.upscaleFactor * dim;
      const vec2 gy = surfaceInteraction.textureGradientY * cb.upscaleFactor * dim;
      const float lenGx = length(gx);
      const float lenGy = length(gy);
      const float majorLen = max(lenGx, lenGy);
      const float minorLen = min(lenGx, lenGy);
      const float anisoMip = (majorLen > 0.0f)
        ? log2(max(minorLen, majorLen / aniMax))
        : 0.0f;

      // Hit distance camera → hit point in world space. Lets us sanity
      // check whether the computed mip is reasonable for that distance.
      // (Wall a few units away should be at a low mip; a wall hundreds
      // of units away at a high mip is normal physics.)
      // Inline of cameraGetWorldPosition to avoid extra include — pulls
      // the translation column out of viewToWorld (camera.slangh:177).
      const vec3 camPos = transpose(cb.camera.viewToWorld)[3].xyz;
      const float hitDistance = length(surfaceInteraction.position - camPos);

      // NV-DXVK: PathCheckerProbe gpuPrint writes are now SUPPRESSED on
      // view 52. Reason: the existing slot 5/6/7/11/12/13 cycle in
      // surface_interaction.slangh now also fires on view 52, and the
      // packet `d.w` tag would collide (mipCount can equal 11). The slot
      // probes carry strictly more information per triangle (txcoords,
      // positions, clipW spread, UV magnitudes, dbgMaxComp), so we keep
      // those and drop the redundant pathCheckerProbe. Visual path
      // colorization on view 52 is unchanged. Re-enable the writes below
      // if a slot-free per-frame readout is wanted again.
      const bool kEmitPathCheckerProbe = false;
      if (kEmitPathCheckerProbe) {
        if ((cb.frameIdx & 1u) == 0u)
        {
          GpuPrint::write(u16vec2(getDispatchRaysIndex().xy), float4(
            float(pathCodeOut),
            anisoMip,
            hitDistance,
            float(albedoMipCount)));
        }
        else
        {
          const float boundDimsPacked = float(albedoW) * 4096.0f + float(albedoH);
          GpuPrint::write(u16vec2(getDispatchRaysIndex().xy), float4(
            254.0f,
            float(texIdx),
            boundDimsPacked,
            cb.totalMipBias));
        }
      }
    }
    // NV-DXVK: actually write the colored albedo to the debug view
    // buffer. Without this, the buffer shows stale / garbage data and
    // the screen looks like grey speckle noise.
    storeInDebugView(getDispatchRaysIndex().xy, albedo.xyz);
  }
  // NV-DXVK [Coverage]: snapshot the raw-sampled albedo at the exact point
  // DEBUG_VIEW_RAW_ALBEDO would display it. This is the value AFTER texture
  // sample + cavity/detail/cloudMask but BEFORE gamma decode, fog mix,
  // albedoScale/Bias, and the metallic-F0 lerp. Compared against the final
  // (encoded) interaction.albedo at the end of this function to identify
  // surfaces whose "raw is zero but encoded is non-zero" — the blot signature.
  const f16vec3 covRawAlbedo = albedo;

  if (cb.debugView == DEBUG_VIEW_RAW_ALBEDO)
  {
    storeInDebugView(getDispatchRaysIndex().xy, albedo.xyz);

    // NV-DXVK [Coverage PureRed store-site]: count pure-red opaque writes RIGHT
    // HERE, UNGATED by surfaceIndex (the <SLOTS-gated PureRed below would skip an
    // out-of-range index). Captures the surfaceIndex range so we can tell whether
    // the red surface has a garbage/OOB index. If this count stays 0, the opaque
    // store never writes the red → it is genuinely non-opaque, written elsewhere.
#ifdef RAY_TRACING_PRIMARY_RAY
    // NV-DXVK: RED-DOMINANT (not strict pure-red) so the varying-hue sky red
    // (orange/grainy/dark) is captured, not just (0.8,0,0). The strict
    // R>0.5/G<0.05/B<0.05 test undercounted everything but the most saturated.
    if (float(albedo.r) > 0.2f
        && float(albedo.r) > float(albedo.g) * 1.5f
        && float(albedo.r) > float(albedo.b) * 1.5f)
    {
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_STORETOTAL], 1u);
      InterlockedMax(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_STOREIDXMAX], inCovSurfaceIndex);
      InterlockedMax(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_STOREIDXMIN], 0xFFFFFFFFu - inCovSurfaceIndex);
      // Per-surface record HERE (store-site is confirmed firing, unlike the
      // <SLOTS coverage block below) so PureRedVS names the actual VS/material.
      // EXCLUDE VGUI: the VGUI fontTexture atlas reads red in RAW_ALBEDO (a
      // known debug-view artifact, ~90k px) and otherwise buries the actual
      // sky/world red. Skipping isVgui makes PureRedVS name the real red shader.
      if (inCovSurfaceIndex < uint(COVERAGE_SURFACE_SLOTS) && !surface.isVgui)
      {
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SURFACE_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_TOTAL], 1u);
        if (albedoOpacityLoaded) {
          InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_TEXLOADED], 1u);
        } else {
          InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_TEXMISSING], 1u);
        }
      }
    }
#endif

    // NV-DXVK: ground-truth probe — bypass all gradient / transform / mip
    // logic by SampleLevel(mip 0) at 4 fixed UV corners on THIS hit's
    // albedo texture. If all four are within a few % of each other, the
    // bound texture is effectively flat and the "flat walls" complaint is
    // a texture-content issue, not a sampling issue. If they differ, the
    // texture has real detail and something else is collapsing it.
    //
    // Cycles one record per frame via frameIdx%4. Output tuples:
    //   probeIdx 0: (r,g,b,0)  — mip0 sample at UV (0.1,0.1)
    //   probeIdx 1: (r,g,b,1)  — mip0 sample at UV (0.9,0.1)
    //   probeIdx 2: (r,g,b,2)  — mip0 sample at UV (0.1,0.9)
    //   probeIdx 3: (interpU, interpV, texIdx, 3) — interpolated UV at hit
    //       + bound texture index, so we can verify UV interpolation is
    //       producing varying values per-pixel (wall pixels should yield
    //       different u,v as camera moves) and cross-check the texIdx
    //       against FillMaterialData's [RDEF] albedo slot.
    {
      // NV-DXVK: cycle is mod 14. Cases 0..4, 8, 10 written here; 5/6/7
      // written from computeAnisotropicEllipseAxes (per-tri UV dump +
      // world-tri edge metric); 11/12/13 also written from
      // computeAnisotropicEllipseAxes (gradient-pipeline path classifier,
      // clip.w spread, UV magnitude summary — added to disambiguate why
      // BSP walls vs skinned meshes diverge through the gradient pipeline).
      // The `else if (probeIdx >= 5u)` branch below catches all
      // surface_interaction-side slots (5/6/7/11/12/13) and lets them
      // fall through without writing here.
      const uint probeIdx = cb.frameIdx % 16u;
      if (probeIdx == 8u) {
        // NV-DXVK: slot 8 — texcoord buffer descriptor as the slang side
        // actually sees it. The `b` channel encodes BOTH texcoordOffset
        // (low) and texcoordEncoding (high) so we can read per-pixel:
        //   real_offset   = b mod 1000
        //   encodingFlag  = floor(b / 1000)   (0=Float, 1=TF2BspUintPacked)
        // CPU log [TexcoordEnc] reports the value Remix's CPU resolved
        // from the bound VS's ISGN; if that says VS=7c38fdf4 → Float (0)
        // but probe 8 reads encodingFlag=1 here, the bit either got
        // overwritten before write, the GPU layout offset is wrong, or
        // the slang getter reads from the wrong location.
        GpuPrint::write(u16vec2(getDispatchRaysIndex().xy),
          float4(float(surface.texcoordBufferIndex),
                 float(surface.texcoordStride),
                 float(surface.texcoordOffset)
                   + float(surface.texcoordEncoding) * 1000.0f,
                 8.0f));
      } else if (probeIdx == 10u) {
        // Case 10: dump full textureTransform — both U and V rows. Together
        // with case 0 (texGenMode + transform[0]) we'll know exactly which
        // world axes (or VB texcoord components) U and V are reading from.
        GpuPrint::write(u16vec2(getDispatchRaysIndex().xy),
          float4(surface.textureTransform[1].x,
                 surface.textureTransform[1].y,
                 surface.textureTransform[1].z,
                 10.0f));
      } else if (probeIdx == 0u) {
        // NV-DXVK: case 0 — texGenMode + textureTransform U row (xyz).
        // TexGenMode values:
        //   0=None (VB texcoords) 1=ViewPositions 2=ViewNormals 3=CascadedViewPositions
        // The U row is paired with case 10 (V row) — together they show
        // exactly which world axes feed U and V. If any row has only one
        // non-zero entry, that single world axis is the input — and a wall
        // whose vertices share that axis's value will collapse to constant U
        // or V across the triangle.
        // 4th value is repurposed: it carries texGenMode (small int 0..3) AND
        // the case marker is encoded by the texGenMode value being a clean
        // small int. To keep grep-ability, we add 100 so it can't collide
        // with corner-sample markers (0/1/2) or a normal float color.
        GpuPrint::write(u16vec2(getDispatchRaysIndex().xy),
          float4(surface.textureTransform[0].x,
                 surface.textureTransform[0].y,
                 surface.textureTransform[0].z,
                 100.0f + float(surface.texcoordGenerationMode)));
      } else if (probeIdx >= 5u) {
        // Cases 5/6/7 written from computeAnisotropicEllipseAxes; skip here.
      } else {
      const uint texIdx = uint(opaqueSurfaceMaterial.albedoOpacityTextureIndex);
      const uint sampIdx = uint(opaqueSurfaceMaterial.samplerIndex);
      // NV-DXVK: query the bound albedo texture's actual dimensions. We use
      // the 2-arg GetDimensions form (matches line 428's pattern); the
      // 4-arg form (with mipCount out-param) crashes slangc when applied
      // to a bindless `nonuniformEXT` array. Mip count is recoverable from
      // floor(log2(max(w,h))) + 1 assuming a full mip chain (true for
      // every BSP/character albedo we've inspected). Without this we were
      // hardcoding 256 in mip math and getting wrong answers — the real
      // BSP wall texture is 512² × 10 mips per Nsight inspection.
      uint2 texDims = uint2(0, 0);
      if (texIdx != BINDING_INDEX_INVALID)
      {
        textures[nonuniformEXT(texIdx)].GetDimensions(texDims.x, texDims.y);
      }
      const uint texW = texDims.x;
      const uint texH = texDims.y;
      const uint texMips = (texW > 0u)
        ? uint(floor(log2(float(max(texW, texH))))) + 1u
        : 0u;
      float4 payload;
      if (probeIdx == 0u)
      {
        // Probe 1 was already used for the textureTransform U row (case 0
        // earlier in the cycle). This branch is reached when probeIdx==0
        // ONLY because `probeIdx == 0u` is also caught by the outer
        // `probeIdx == 0u` upthread — keep this for safety, but probeIdx==0
        // is handled before we get here.
        payload = float4(0,0,0,0);
      }
      else if (probeIdx == 1u)
      {
        // Probe 1 — bound albedo texture dimensions and mip count.
        //   r = texture width (mip 0)
        //   g = texture height (mip 0)
        //   b = mip count
        //   a = 1
        payload = float4(float(texW), float(texH), float(texMips), 1.0f);
      }
      else if (probeIdx == 2u)
      {
        // Probe 2 — what HW samples at this hit pixel given the gradients
        // computeAnisotropicEllipseAxes produced. SampleGrad with the same
        // gradients textureRead would use in the actual render pass.
        //   r,g,b = sampled albedo color
        //   a = 2
        f16vec4 probeSample = f16vec4(0.0);
        if (texIdx != BINDING_INDEX_INVALID)
        {
          probeSample = textures[nonuniformEXT(texIdx)].SampleGrad(
            samplers[nonuniformEXT(sampIdx)],
            surfaceInteraction.textureCoordinates,
            surfaceInteraction.textureGradientX,
            surfaceInteraction.textureGradientY);
        }
        payload = float4(float(probeSample.r), float(probeSample.g), float(probeSample.b), 2.0f);
      }
      else if (probeIdx == 3u)
      {
        payload = float4(
          float(surfaceInteraction.textureCoordinates.x),
          float(surfaceInteraction.textureCoordinates.y),
          float(texIdx),
          3.0f);
      }
      else
      {
        // NV-DXVK: probe 4 — gradient + effective mip with 16× aniso.
        //   r = gxLen
        //   g = gyLen
        //   b = effective mip = log2(max(rhoMin, rhoMax/16) * texW). With
        //       this and probe 1 (texW), we have the complete mip-selection
        //       calculation. Compare to: native HW mipApprox = log2(rho *
        //       texW) where rho is HW-computed ddx/ddy in screen space.
        //   a = 4
        const float gxLen = length(surfaceInteraction.textureGradientX);
        const float gyLen = length(surfaceInteraction.textureGradientY);
        const float rhoMax = max(gxLen, gyLen);
        const float rhoMin = min(gxLen, gyLen);
        const float kAniso = 16.0f;
        const float rhoMinEff = max(rhoMin, rhoMax / kAniso);
        const float mipAniso = log2(max(rhoMinEff * float(max(texW, 1u)), 1.0f));
        payload = float4(gxLen, gyLen, mipAniso, 4.0f);
      }
      GpuPrint::write(u16vec2(getDispatchRaysIndex().xy), payload);
      } // close `else {` for probeIdx < 5
    }
  }

  if (cb.debugView == DEBUG_VIEW_OPAQUE_RAW_ALBEDO_RESOLUTION_CHECKERS)
  {
    storeColorOverlayedWithTextureResolutionCheckersInDebugView(albedo.xyz, opaqueSurfaceMaterial.albedoOpacityTextureIndex, surfaceInteraction);
  } 

  storeSamplerFeedback(opaqueSurfaceMaterial.samplerFeedbackStamp, surfaceInteraction);

  // NV-DXVK: per-pixel scene dump. The actual write logic lives in
  // writeSceneDumpEntry() (top of this file) — kept out-of-line because
  // slangc's optimizer crashes (access violation, no diagnostic) when the
  // GetDimensions + SVD + struct-store sequence is inlined into closesthit
  // variants. Same workaround pattern as computeFragmentDdxDdyPerspective.
  if (cb.sceneDumpEnabled != 0u)
  {
    // NV-DXVK [perf]: the path code and clip-w diagnostics are only carried
    // per-pixel when REMIX_SI_DEBUG_FIELDS is on. The dump itself still runs and
    // still records the real per-pixel data (texcoords, gradients, texture index,
    // lightmap); only the four gradient-diagnostic columns read as zero.
#if REMIX_SI_DEBUG_FIELDS
    const uint  sdPathCode = uint(surfaceInteraction.debugPathCode);
    const float sdMinClipW = surfaceInteraction.dbgMinClipW;
    const float sdMaxClipW = surfaceInteraction.dbgMaxClipW;
    const vec3  sdHitWorld = surfaceInteraction.dbgHitWorld;
#else
    const uint  sdPathCode = 255u;
    const float sdMinClipW = 0.0f;
    const float sdMaxClipW = 0.0f;
    const vec3  sdHitWorld = vec3(0.0f);
#endif
    writeSceneDumpEntry(
      surfaceInteraction.textureCoordinates,
      surfaceInteraction.textureGradientX,
      surfaceInteraction.textureGradientY,
      uint(opaqueSurfaceMaterial.albedoOpacityTextureIndex),
      sdPathCode,
      surfaceInteraction.lightmapTextureCoordinates,
      surface.hasLightmap,
      sdMinClipW,
      sdMaxClipW,
      sdHitWorld);
  }

#endif

  f16vec4 tFactor = unorm4x8ToFloat4x16(surface.tFactor).bgra;

  // WAR for REMIX-1573: texture ops for opacity should happen during baking and be skipped here for baked terrain,
  // but right now the opacity is not 1 in the baked texture where it is expected to be and thus texture ops
  // are required to blend the layer contributions properly 
#if 0
  if (applyTextureOperations) 
#endif
  {
    if (surface.isVertexColorBakedLighting) {
      // "Normalize" vertex color to remove lighting contribution in different vertices.
      // We assume the diffuse term contributes most lighting. Therefore, vertex color = diffuseColor * (N*L).
      // By dividing the vertex color by its largest component, the result is irrelavant to N*L, but proportional to the 
      // original diffuse color, which is more desired.
      // In practice, we add an adjustable blending factor to avoid extreme cases.
      surfaceInteraction.vertexColor.rgb = max(surfaceInteraction.vertexColor.rgb, f16vec3(1.0 / 255.0));
      float16_t maxColor = max(surfaceInteraction.vertexColor.r, max(surfaceInteraction.vertexColor.g, surfaceInteraction.vertexColor.b));
      surfaceInteraction.vertexColor.rgb /= maxColor;
      surfaceInteraction.vertexColor.rgb = mix(f16vec3(1), surfaceInteraction.vertexColor.rgb, float16_t(cb.vertexColorStrength));
    }

    // Fixed function texture stage setting
    f16vec3 textureArg1 = f16vec3(1.0), textureArg2 = f16vec3(1.0);
    chooseTextureArgument(textureArg1, surface.textureColorArg1Source, albedo, surfaceInteraction.vertexColor.rgb, tFactor.rgb, f16vec3(1.0));
    chooseTextureArgument(textureArg2, surface.textureColorArg2Source, albedo, surfaceInteraction.vertexColor.rgb, tFactor.rgb, f16vec3(1.0));
    chooseTextureOperationColor(albedo, surface.textureColorOperation, textureArg1, textureArg2);
    if (surface.isTextureFactorBlend) {
      albedo *= tFactor.rgb;
    }

    // Fixed function texture stage setting (emissive)
    chooseTextureArgument(textureArg1, surface.textureColorArg1Source, emissiveColor, surfaceInteraction.vertexColor.rgb, tFactor.rgb, f16vec3(1.0));
    chooseTextureArgument(textureArg2, surface.textureColorArg2Source, emissiveColor, surfaceInteraction.vertexColor.rgb, tFactor.rgb, f16vec3(1.0));
    chooseTextureOperationColor(emissiveColor, surface.textureColorOperation, textureArg1, textureArg2);
    if (surface.isTextureFactorBlend) {
      emissiveColor *= tFactor.rgb;
    }
    
    // Adjust opacity via texture operations.
    // Fixed function texture stage state for alpha channel

    float16_t textureAlphaArg1, textureAlphaArg2;
    chooseTextureArgument(textureAlphaArg1, surface.textureAlphaArg1Source, opacity, surfaceInteraction.vertexColor.a, tFactor.a, opacity);
    chooseTextureArgument(textureAlphaArg2, surface.textureAlphaArg2Source, opacity, surfaceInteraction.vertexColor.a, tFactor.a, float16_t(1.0h));
    chooseTextureOperationAlpha(opacity, surface.textureAlphaOperation, textureAlphaArg1, textureAlphaArg2);
    
    // Ensure we perform these opacity calculations after the texture operations have been applied to abledo and alpha.
    calcOpaqueSurfaceMaterialOpacity(
      albedo, opacity, surface, opacity, emissiveBlendOverrideInfluence, cb.wboitEnabled);
  }

  if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_IGNORE_ALPHA_CHANNEL)
  {
    opacity = 1.h;
  }
  
  // Gamma correct albedo input (be it from a constant or a texture).
  // NV-DXVK: if the albedo came from an sRGB-format texture the hardware
  // sampler already did sRGB->linear, so running gammaToLinear() again
  // would double-decode and crush the albedo dark. The CPU sets
  // OPAQUE_SURFACE_MATERIAL_FLAG_ALBEDO_IS_SRGB when the bound albedo view
  // is an sRGB format. The constant fallback (no texture loaded) is always
  // authored in gamma space, so it must still be converted.
  const bool albedoFromSrgbTexture = albedoOpacityLoaded
    && (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALBEDO_IS_SRGB) != 0;
  if (!albedoFromSrgbTexture)
  {
    albedo = gammaToLinear(albedo);
  }
  // NV-DXVK [Coverage]: stage-B snapshot. Post-TF2-fixed-function ops + post
  // gamma decode (skipped for sRGB-format textures). region 6 (DriftStageGamma)
  // measures incremental drift from raw at this point. If region 6 dominates
  // on a blot VS, gamma decode or the fixed-function texture-op stage is the
  // mechanism.
  const f16vec3 covPostGamma = albedo;

  // NV-DXVK: TF2 3D-skybox cloud fog reconstruction. The cloud-billboard
  // pixel shader synthesizes its visible colour from the engine fog math —
  // the bound texture is only a near-black coverage/detail map, so path
  // tracing its RGB as albedo renders the soft cloud edges black. Rebuild
  // the game PS's colour for Surface::isTf2SkyboxFog surfaces (3D-skybox
  // cloud billboards only), using the fog constants captured into
  // cb.tf2Fog* (see d3d11_rtx.cpp
  // FillMaterialData / HANDOFF_CLOUDS.md). Original PS (FS_635c09a18d267ec4):
  //   sunAmount = saturate((dot(k3.xyz, viewDir) - k2.w) * k3.w)
  //   fogColor  = k2.xyz * sunAmount^2 + k1.xyz
  //   colour    = lerp(normalize(albedo), fogColor * c_fogColorFactor, k0.w)
  // viewDir is camera->surface; done in linear space (the engine fog colours
  // are linear HDR). fogFactor is taken as k0.w (the fog cap) because the
  // reprojected 3D skybox sits at effective infinite distance, which
  // saturates the height/distance fog integral.
  if (surface.isTf2SkyboxFog && cb.tf2FogMisc.z != 0.0f)
  {
    const vec3 camPos = transpose(cb.camera.viewToWorld)[3].xyz;
    const vec3 viewDir = normalize(surfaceInteraction.position - camPos);

    const vec3  k1 = cb.tf2FogK1_K0W.xyz;
    const float k0w = saturate(cb.tf2FogK1_K0W.w);
    const vec3  k2 = cb.tf2FogK2_K2W.xyz;
    const float k2w = cb.tf2FogK2_K2W.w;
    const vec3  k3dir = cb.tf2FogK3.xyz;
    const float k3scale = cb.tf2FogK3.w;
    const float fogColorFactor = cb.tf2FogMisc.x;
    const float maxLighting = max(cb.tf2FogMisc.y, 1e-4f);

    const float sunAmount = saturate((dot(k3dir, viewDir) - k2w) * k3scale);
    const vec3 fogColor = k2 * (sunAmount * sunAmount) + k1;

    // Game's pre-fog HDR normalize: scales the colour down so its max
    // channel does not exceed maxLighting; a no-op for the dim cloud texture.
    const vec3 linAlbedo = vec3(albedo);
    const float maxCh = max(linAlbedo.r, max(linAlbedo.g, linAlbedo.b));
    const vec3 normColor = linAlbedo * (maxLighting / max(maxCh, maxLighting));

    albedo = f16vec3(mix(normColor, fogColor * fogColorFactor, k0w));

    // [CloudFogShader] Diagnostic — confirms the reconstruction branch
    // actually executed on the GPU (the CPU-side [CloudFog] log only proves
    // the constants were captured + the material flagged). Writes the
    // gpuPrint ring slot, tag 23.0; decoded in rtx_context.cpp. Last writer
    // per frame wins — any flagged cloud pixel answers "did it run". Gated
    // to gpuPrint being enabled.
    if (cb.gpuPrintThreadIndex.x != kInvalidThreadIndex)
    {
      GpuPrintBufferElement cloudFogProbe;
      cloudFogProbe.threadIndex = u16vec2(getDispatchRaysIndex().xy);
      cloudFogProbe.frameIndex  = cb.frameIdx;
      cloudFogProbe.writtenData = float4(
        float(calcBt709Luminance(albedo)),  // reconstructed colour luminance
        k0w,                                 // fog factor applied
        sunAmount,                           // sun-tint term
        23.0f);                              // tag
      GpuPrintBuffer[cb.gpuPrintElementIndex] = cloudFogProbe;
    }
  }

  // Note: Gamma correct emissive color input (be it from a constant or a texture). Currently assuming all textures are not using sRGB formats which
  // automatically do this conversion.
  // Todo: Disable this for when a sRGB texture is the source of the emissive color.
  emissiveColor = gammaToLinear(emissiveColor);
  
  // Apply material modifiers/overrides
  albedo = saturate(albedo * cb.opaqueMaterialArgs.albedoScale + cb.opaqueMaterialArgs.albedoBias);
  // NV-DXVK [Coverage]: stage-D snapshot. Post material-args scale/bias.
  // Stage-C (TF2 skybox fog) is folded in here too if it ran. region 7
  // (DriftStageScaleBias) = incremental drift from stage-B. Catches a bad
  // cb.opaqueMaterialArgs.albedoScale/albedoBias value (per-frame uniform)
  // and TF2 fog reconstruction co-incidence.
  const f16vec3 covPostScaleBias = albedo;
  
  if (cb.opaqueMaterialArgs.enableThinFilmOverride)
  {
    // Note: Thickness override is already normalized to the proper 0-1 range by the CPU to match how the albedo texture alpha channel encodes thickness.
    thinFilmThickness = cb.opaqueMaterialArgs.thinFilmNormalizedThicknessOverride;
  }

  // Load Normal

  f16vec3 normal = surfaceInteraction.interpolatedNormal;
  // Note: Defaults to 0 as this indicates no normal detail (which should be the case when a normal map is not present).
  float16_t normalDetail = 0.0h;

  if (normalLoaded)
  {
    f16vec3 tangentNormal;

    // Terrain baker produces decoded tangentNormal and (first) normal.
    if (isBakedTerrain)  
    {
      // REMIX-2224: Normals blended during terrain baking using programmable shaders can sometimes end up being invalid so we sanitize them at this point
      tangentNormal = sanitize(normalSample.xyz, cb.isZUp ? f16vec3(0.h, 0.h, 1.h) : f16vec3(0.h, 1.h, 0.h));
    }
    else // Decode encoded normal sample
    {
      // Note: Using f16 from texture to decode from is fine as the original texture is only 8 bits of precision.
      tangentNormal = unsignedOctahedralToHemisphereDirection(vec2(normalSample.xy), cb.opaqueMaterialArgs.normalIntensity);
    }
    
    const f16mat3 tangentToWorld = transpose(worldToTangent);

    normal = normalize(mul(tangentToWorld, tangentNormal));

    // REMIX-2224: Normals blended during terrain baking using programmable shaders can sometimes end up being invalid
    // after being transformed to world space so we sanitize them here
    if (isBakedTerrain) {
      normal = sanitize(normal, cb.isZUp ? f16vec3(0.h, 0.h, 1.h) : f16vec3(0.h, 1.h, 0.h));
    }

    // Note: Only factoring in the initial normal map read as part of the normal map calculation as the second normal acts blends in worldspace which
    // would re-introduce the potential for precision issues that we're trying to avoid in this calculation. Additionally, the second normal is only used
    // currently for water effects and is sampled from a less detailed mip, so it is likely not too relevant for "detail" in the normal map with regards
    // to what the normal detail is used for (denoiser disocclusion threshold modifications).
    normalDetail = 1.0h - tangentNormal.z; // Note: 1 - n.z == 1 - dot(n, vec3(0, 0, 1))

    if (secondNormalLoaded)
    {
      f16vec3 tangentNormal2 = unsignedOctahedralToHemisphereDirection(vec2(secondNormalSample.xy), cb.opaqueMaterialArgs.normalIntensity);
      
      tangentNormal2 = normalBlendRNM(tangentNormal2, tangentNormal);
      normal = normalize(mul(tangentToWorld, tangentNormal2));

    }
  }
  
#if defined(RAY_TRACING_PRIMARY_RAY)
  if (cb.debugView == DEBUG_VIEW_OPAQUE_NORMAL_RESOLUTION_CHECKERS) 
  {
    storeColorOverlayedWithTextureResolutionCheckersInDebugView(normal, opaqueSurfaceMaterial.normalTextureIndex, surfaceInteraction);
  }
#endif
  // Load Tangent

  // Todo

  // Load Roughness

  float16_t roughness = opaqueSurfaceMaterial.roughnessConstant;

  // NV-DXVK: TF2/Source-engine spec/gloss workflow. Texture forwarded to the
  // roughnessTexture slot is actually a perceptual GLOSS map (R channel,
  // 1 = smooth). Verified via fxc /dumpbin on FS_7a6e4c5725a53e07*: t2 is
  // sampled with .yzwx into r2.w then `add r2.w, -r2.w, l(1.0)` and finally
  // `max r2.w, r2.w, l(0.04)` — i.e. `roughness = max(1 - gloss.r, 0.04)`.
  // Mirror the same floor here so spec lobes don't go infinitesimal on
  // ultra-glossy texels (which would otherwise produce mirror-bright
  // highlights on the gauntlet menu walls).
  // NV-DXVK: hardcoded for this fork — TF2's only material producer is
  // LegacyMaterialData::as<OpaqueMaterialData>() and rtx.conf is bypassed
  // (see [d3d11_main] skipping RtxOptions::Create() in d3d11.dll), so the
  // cb.opaqueMaterialArgs.legacyGlossSpecWorkflow flag is unreliable.
  // Inversion always runs.
  if (roughnessLoaded)
  {
    roughness = max(float16_t(1.0h) - roughnessSample.r, float16_t(0.04h));
  }

#if defined(RAY_TRACING_PRIMARY_RAY)
  if (cb.debugView == DEBUG_VIEW_OPAQUE_ROUGHNESS_RESOLUTION_CHECKERS)
  {
    storeColorOverlayedWithTextureResolutionCheckersInDebugView(roughness.xxx, opaqueSurfaceMaterial.roughnessTextureIndex, surfaceInteraction);
  }
#endif
  // Apply material modifiers
  roughness = saturate(roughness * cb.opaqueMaterialArgs.roughnessScale + cb.opaqueMaterialArgs.roughnessBias);

  // Load Metallic

  float16_t metallic = opaqueSurfaceMaterial.metallicConstant;

  // NV-DXVK: TF2/Source-engine spec/gloss workflow. Texture forwarded to the
  // metallicTexture slot is actually a Schlick F0 RGB color map (`specTexture`
  // in TF2). Verified via fxc dump line 310/433 of FS_7a6e4c5725a53e07*:
  //   r4.xyz = sample(t3); … add r11.xyz, -r4.xyzx, l(1,1,1,0)   ; (1 - F0)
  // i.e. F0 is consumed directly as a per-pixel RGB Fresnel base, NOT as a
  // metalness mask.
  // Reproject into the metallic-roughness BRDF such that the BRDF's
  // F0_eff = lerp(0.04, albedo, metallic) ≈ F0_actual:
  //   metallic = saturate((luminance(F0) - 0.04) / 0.96)
  //   albedo'  = lerp(albedo, F0, metallic)
  // Result: dielectrics (F0 ≈ 0.04) → metallic = 0, albedo unchanged;
  // metals (F0 high & coloured) → metallic = 1, albedo = F0 → BRDF F0 = F0;
  // smooth blend in between preserves Phong-style coloured-spec tint that
  // raw metallic-roughness can't otherwise represent.
  // NV-DXVK: hardcoded — see roughness branch above for rationale.
  if (metallicLoaded)
  {
    const f16vec3 f0 = f16vec3(metallicSample.rgb);
    const float16_t f0Lum = dot(f0, f16vec3(0.299h, 0.587h, 0.114h));
    metallic = saturate((f0Lum - float16_t(0.04h)) * float16_t(1.0416667h)); // /0.96
    albedo = lerp(albedo, f0, metallic);
  }

  metallic = saturate(metallic * cb.opaqueMaterialArgs.metallicScale + cb.opaqueMaterialArgs.metallicBias);
  // NV-DXVK [Coverage]: stage-E snapshot. Post metallic-F0 lerp. region 8
  // (DriftStageMetallic) = incremental drift from stage-D. THE prime suspect:
  // if metallicSample.rgb intermittently reads wrong (stale descriptor, mip
  // race, etc.), lerp(albedo, f0, metallic) collapses encoded toward f0 —
  // exactly the "noisy purple/dark blob" signature.
  const f16vec3 covPostMetallic = albedo;

  // Transform to desired Opaque Material Interaction values

  opaqueSurfaceMaterialInteraction.shadingNormal = getBentNormal(surfaceInteraction.triangleNormal, normal, -minimalRayInteraction.viewDirection);
  opaqueSurfaceMaterialInteraction.normalDetail = normalDetail;
  // Todo: Shading tangent/bitangent for anisotropy?
  opaqueSurfaceMaterialInteraction.opacity = opacity;
  opaqueSurfaceMaterialInteraction.thinFilmThickness = thinFilmThickness;

  // (Path-code colorization happens above near the DEBUG_VIEW_RAW_ALBEDO
  // store so the debug view sees the colors too.)

  // Note: Opacity factored into albedo and base reflectivity to ensure NEE and indirect lighting off of objects with opacity properly
  // account for how much light is being transmitted due to the opacity (similar to how Fresnel on glass works).
  // NV-DXVK: when the source D3D11 draw used premultiplied-alpha blending
  // (BlendEnable=1, SrcBlend=ONE, DestBlend=INV_SRC_ALPHA, BlendOp=ADD),
  // the sampled .rgb is already (color * alpha). albedoToAdjustedAlbedo
  // is `baseAlbedo * (1 - metallic) * opacity` — for premult sources we
  // must skip BOTH the opacity multiply AND the (1 - metallic) multiply,
  // otherwise the encoded albedo doesn't equal the original premultiplied
  // color. (First attempt only forced opacity=1; if metallicConstant > 0
  // on these surfaces the (1 - metallic) factor still produces visible
  // dark-speckle drift. Verified by region 5 staying at ~866k pixels for
  // VS 0x2904 even after the opacity-only fix.) For premult sources we
  // hand back the raw `albedo` directly; the `opacity` field below still
  // flows untouched so path-tracer transmission stays correct, and the
  // base reflectivity path mirrors the same bypass.
  const bool isPremultSource =
    (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALBEDO_IS_PREMULTIPLIED) != 0u;
  opaqueSurfaceMaterialInteraction.albedo = surface.isMatte ? f16vec3(0)
    : (isPremultSource ? albedo : albedoToAdjustedAlbedo(albedo, metallic, opacity));
  opaqueSurfaceMaterialInteraction.baseReflectivity = surface.isMatte ? f16vec3(0)
    : (isPremultSource ? mix(materialBaseReflectivityDielectric, albedo, metallic)
                       : calcBaseReflectivity(albedo, metallic, opacity));
   
  // Note: Roughness loaded from texture is a perceptual roughness value (for optimal encoding), so this works as intended.
  calcRoughness(roughness, opaqueSurfaceMaterial.anisotropy,
    opaqueSurfaceMaterialInteraction.isotropicRoughness,
    opaqueSurfaceMaterialInteraction.anisotropicRoughness);

  opaqueSurfaceMaterialInteraction.emissiveRadiance = emissiveBlendOverrideInfluence * emissiveColor * opaqueSurfaceMaterial.emissiveIntensity;

  // NV-DXVK [BakedAlbedoEmissive]: for surfaces whose final colour is
  // already baked into the texture by the original game pixel shader
  // (no in-engine lighting at authoring time), route the just-computed
  // albedo into emissiveRadiance and zero albedo + baseReflectivity.
  // The path tracer then outputs the baked colour directly, bypassing
  // its `radiance = light_integral × albedo` step that would otherwise
  // produce black wherever no light reaches the surface.
  //
  // Concrete case: TF2's 3D-skybox painted hemispheric dome sits at
  // world-space Z = -1M to -7.3M units; no in-scene light reaches that
  // far, the sky probe is empty, so `albedo × 0 = 0` and the dome
  // renders pure black despite the GBuffer holding the correct sampled
  // colour.
  //
  // Source signal: DrawCallTransforms::isSubViewSkybox, derived from
  // engine-hook sub-view tag (camO matches g_engineSkyCamOrigin within
  // 4u) AND world-space AABB diagonal > 5M units. Plumbed to this flag
  // via SceneManager::createSurfaceMaterial. Position chosen: AFTER
  // the emissiveRadiance default assignment above (so our value
  // overrides the default) and BEFORE the VGUI dispatch (which has
  // its own return path and is never set on sky-dome content).
  if ((opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_BAKED_ALBEDO_AS_EMISSIVE) != 0u)
  {
    opaqueSurfaceMaterialInteraction.emissiveRadiance =
      f16vec3(opaqueSurfaceMaterialInteraction.albedo);
    opaqueSurfaceMaterialInteraction.albedo = f16vec3(0);
    opaqueSurfaceMaterialInteraction.baseReflectivity = f16vec3(0);
  }

  // NV-DXVK: TF2 worldspace VGUI evaluator dispatch. When the surface was
  // identified as a VGUI panel by D3D11Rtx::FillMaterialData (PS RDEF
  // triple-match: fontTexture + g_fontBounds + g_imgBounds; sets
  // mat.sourceIsUnlitUI which propagates to surface.isVgui), run the
  // ported PS instead of using the regular albedo+BRDF path. The VGUI
  // evaluator returns RGBA — RGB becomes pure emission (surface.isMatte
  // is also set so albedo/baseReflectivity are zeroed at line 1446-1447,
  // matching the original PS's "write straight to RT, no lighting"
  // semantics) and A becomes opacity. VGUI panels are never eyes, never
  // need ALPHA_MODULATE_EMISSIVE etc., so the early return here is safe
  // — none of the trailing material code applies to them.
  if (surface.isVgui)
  {
    const float4 vguiColor = vgui::evaluateVgui(
      surface, surfaceInteraction,
      textures[NonUniformResourceIndex(uint(opaqueSurfaceMaterial.albedoOpacityTextureIndex))],
      textures[NonUniformResourceIndex(uint(opaqueSurfaceMaterial.secondaryTextureIndex))],
      samplers[NonUniformResourceIndex(uint(opaqueSurfaceMaterial.samplerIndex))]);
    opaqueSurfaceMaterialInteraction.emissiveRadiance = f16vec3(vguiColor.rgb);
    opaqueSurfaceMaterialInteraction.opacity = float16_t(vguiColor.a);
    return opaqueSurfaceMaterialInteraction;
  }

  // NV-DXVK: TF2/Source `c_useAlphaModulateEmissive` semantic. The PS
  // multiplies its emission by the per-pixel albedo opacity when this flag
  // is set; the path tracer must do the same so a material's "emissive
  // strength" tracks its visible coverage (e.g. an emissive panel mask
  // where alpha=0 patches stay dark instead of glowing through). The flag
  // bit is plumbed from CBufUberStatic.c_useAlphaModulateEmissive in
  // d3d11_rtx.cpp::FillMaterialData → LegacyMaterialData → OpaqueMaterial
  // Data → RtOpaqueSurfaceMaterial::flags.
  if (opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALPHA_MODULATE_EMISSIVE)
  {
    opaqueSurfaceMaterialInteraction.emissiveRadiance *= opacity;
  }

  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction =
    subSurfaceMaterialReadHelper(opaqueSurfaceMaterial.subsurfaceMaterialIndex, surfaceInteraction, opaqueSurfaceMaterial.samplerIndex);

  // For an eye, load a secondary texture (iris) and blend on top of primary texture (whites)
  if (cb.eyeArgs.enableEyes && surface.isEye)
  {
    overrideMaterialInteractionForEye(
      opaqueSurfaceMaterialInteraction,
      opaqueSurfaceMaterial,
      surfaceInteraction,
      surface,
      albedo,
      worldToTangent,
      minimalRayInteraction
    );
  }

  // NV-DXVK [Coverage]: per-surface diff between the *final encoded albedo*
  // (what ends up in polymorphic.vdata0 → Diffuse Albedo view) and the
  // *raw-sampled albedo* (what Diffuse Raw Albedo view shows). Two regions:
  //   region 0 = encoded non-zero
  //   region 1 = raw non-zero
  // A surfaceIndex that appears in region 0 but NOT region 1 has its raw
  // sample at ~0 while its encode is non-zero — meaning the transforms
  // between the RAW write and the final assignment (gamma decode, fog mix,
  // albedoScale/Bias, metallic-F0 lerp) are fabricating colour out of a
  // zero source. That's the GBuffer-encode mismatch behind the blot that
  // appears in Diffuse Albedo + composite but not in Diffuse Raw Albedo.
  //
  // Gated on RAY_TRACING_PRIMARY_RAY so non-primary callers (visibility,
  // nee_cache_light) compile out the binding reference entirely; the
  // inCovSurfaceIndex parameter is still passed through but unused there.
  //
  // Threshold dot > 0.001 ignores fp16 noise while catching meaningful
  // contributions. Per-channel sum (dot with vec3(1)) so any one bright
  // channel still trips it.
#ifdef RAY_TRACING_PRIMARY_RAY
  // NV-DXVK [Coverage NaN]: detect a NaN/Inf RAW albedo — the exact condition
  // the debug-view Inf/NaN visualizer uses to paint a pixel red (NaN) / blue
  // (Inf). Matched to that postprocess (isnan/isinf) so the same pixels trip.
  const float3 covRawAlbedoF = float3(covRawAlbedo);
  const bool covAlbedoIsBad =
    any(isnan(covRawAlbedoF)) || any(isinf(covRawAlbedoF)) || any(covRawAlbedoF != covRawAlbedoF);
  // OOR case first: a bad-albedo hit whose surfaceIndex is out of slot range
  // can't be recorded per-surface below, so count it at slot 0. A high value
  // here means the index itself is the problem, not a known surface's albedo.
  if (covAlbedoIsBad && inCovSurfaceIndex >= uint(COVERAGE_SURFACE_SLOTS))
  {
    InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_NAN_OOR_COUNT_REGION * uint(COVERAGE_SURFACE_SLOTS)], 1u);
  }
  if (inCovSurfaceIndex < uint(COVERAGE_SURFACE_SLOTS))
  {
    if (dot(opaqueSurfaceMaterialInteraction.albedo, f16vec3(1.0h)) > float16_t(0.001h))
    {
      InterlockedAdd(SurfaceCoverageBuffer[0u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
    }
    if (dot(covRawAlbedo, f16vec3(1.0h)) > float16_t(0.001h))
    {
      InterlockedAdd(SurfaceCoverageBuffer[1u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      // NV-DXVK [Coverage color]: accumulate the per-surface raw-albedo colour
      // (saturated to [0,1], quantized *255) under the SAME gate/count as
      // region 1, so the CPU readback can divide colour-sum by region-1 count
      // to recover the average raw albedo per VS and match an on-screen colour
      // (e.g. a bright-red blot ⇒ avg ≈ (255,0,0)) to a specific shader.
      const float3 covRawAlbedoSat = saturate(float3(covRawAlbedo));
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_RAWALBEDO_R_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], uint(covRawAlbedoSat.r * 255.0f + 0.5f));
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_RAWALBEDO_G_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], uint(covRawAlbedoSat.g * 255.0f + 0.5f));
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_RAWALBEDO_B_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], uint(covRawAlbedoSat.b * 255.0f + 0.5f));
      // Red-dominant pixel count (localizes the bright-red blot that averaging hides).
      if (covRawAlbedoSat.r > 0.4f &&
          covRawAlbedoSat.r > covRawAlbedoSat.g * 1.5f + 0.05f &&
          covRawAlbedoSat.r > covRawAlbedoSat.b * 1.5f + 0.05f)
      {
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDPIXEL_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        // World-space AABB of red pixels (biased InterlockedMax at slot 0).
        const float3 redPos = float3(surfaceInteraction.position);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDPOS_MAXX_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redPos.x + COVERAGE_REDPOS_BIAS + 0.5f));
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDPOS_MINX_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(COVERAGE_REDPOS_BIAS - redPos.x + 0.5f));
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDPOS_MAXY_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redPos.y + COVERAGE_REDPOS_BIAS + 0.5f));
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDPOS_MINY_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(COVERAGE_REDPOS_BIAS - redPos.y + 0.5f));
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDPOS_MAXZ_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redPos.z + COVERAGE_REDPOS_BIAS + 0.5f));
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDPOS_MINZ_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(COVERAGE_REDPOS_BIAS - redPos.z + 0.5f));
        // Screen-space bbox of red pixels (compact box vs scattered speckle).
        const uint2 redPix = getDispatchRaysIndex().xy;
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDSCR_MAXX_REGION * uint(COVERAGE_SURFACE_SLOTS)], redPix.x);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDSCR_MINX_REGION * uint(COVERAGE_SURFACE_SLOTS)], COVERAGE_REDSCR_BIAS - redPix.x);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDSCR_MAXY_REGION * uint(COVERAGE_SURFACE_SLOTS)], redPix.y);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDSCR_MINY_REGION * uint(COVERAGE_SURFACE_SLOTS)], COVERAGE_REDSCR_BIAS - redPix.y);
        // Hit-distance stats of red pixels (correct-depth-wrong-albedo vs anomalous-depth wrong-hit).
        const float3 redCamPos = transpose(cb.camera.viewToWorld)[3].xyz;
        const float redDist = length(float3(surfaceInteraction.position) - redCamPos);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDDIST_MAX_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redDist + 0.5f));
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDDIST_MIN_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(COVERAGE_REDDIST_BIAS - redDist + 0.5f));
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDDIST_SUM_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redDist + 0.5f));
        // NV-DXVK [Coverage red sample/mip]: discriminator — is the red already
        // in the BARE texture sample, and what mip/gradient produced it?
        // covRawAlbedo (the gate above) is POST-modulation; albedoOpacitySample
        // is the raw texture read (pre AO/detail/cloud). If this is red too, the
        // texture sample itself is wrong (UV/mip/texel); if it's normal-brown,
        // a modulation stage fabricated the red.
        const float3 redBareSample = albedoOpacityLoaded
          ? saturate(float3(albedoOpacitySample.rgb))
          : saturate(float3(opaqueSurfaceMaterial.albedoOpacityConstant.rgb));
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDSAMPLE_R_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redBareSample.r * 255.0f + 0.5f));
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDSAMPLE_G_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redBareSample.g * 255.0f + 0.5f));
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDSAMPLE_B_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redBareSample.b * 255.0f + 0.5f));
        // Texture-gradient magnitude (drives mip selection in textureRead's
        // SampleGrad). Blown-up or collapsed vs neighbours = bad mip.
        const float redGrad = max(length(surfaceInteraction.textureGradientX),
                                  length(surfaceInteraction.textureGradientY));
        const uint redGradQ = uint(min(redGrad * COVERAGE_REDGRAD_SCALE, COVERAGE_REDGRAD_BIAS - 1.0f) + 0.5f);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDGRAD_MAX_REGION * uint(COVERAGE_SURFACE_SLOTS)], redGradQ);
        InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDGRAD_MIN_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(COVERAGE_REDGRAD_BIAS) - redGradQ);
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDGRAD_SUM_REGION * uint(COVERAGE_SURFACE_SLOTS)], redGradQ);
        // Which gradient-pipeline branch fired (OR-mask of debugPathCode bits).
        // Only meaningful when the path code is carried per-pixel; with
        // REMIX_SI_DEBUG_FIELDS off this region reads as the "unset" bit.
#if REMIX_SI_DEBUG_FIELDS
        InterlockedOr(SurfaceCoverageBuffer[COVERAGE_REDPATH_MASK_REGION * uint(COVERAGE_SURFACE_SLOTS)], 1u << min(surfaceInteraction.debugPathCode, 31u));
#else
        InterlockedOr(SurfaceCoverageBuffer[COVERAGE_REDPATH_MASK_REGION * uint(COVERAGE_SURFACE_SLOTS)], 1u << 31u);
#endif
        // NV-DXVK [Coverage red detail]: only the detail overlay can turn the
        // brown bare sample red (AO/cloud are grayscale). Capture the detail
        // sample + which modulation stages ran + the detail texture index, to
        // confirm the stage and tell wrong-index-during-warmup from a genuinely
        // red detail texture/blend mode.
        uint redModMask = 0u;
        if (ambientOcclusionLoaded) { redModMask |= 1u; }
        if (detailLoaded)           { redModMask |= 2u; }
        if (cloudMaskLoaded)        { redModMask |= 4u; }
        InterlockedOr(SurfaceCoverageBuffer[COVERAGE_REDMOD_MASK_REGION * uint(COVERAGE_SURFACE_SLOTS)], redModMask);
        if (detailLoaded)
        {
          const float3 redDetail = saturate(float3(detailSample.rgb));
          InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDDETAIL_R_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redDetail.r * 255.0f + 0.5f));
          InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDDETAIL_G_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redDetail.g * 255.0f + 0.5f));
          InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDDETAIL_B_REGION * uint(COVERAGE_SURFACE_SLOTS)], uint(redDetail.b * 255.0f + 0.5f));
          const uint redDetailIdx = uint(opaqueSurfaceMaterial.detailTextureIndex);
          InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDDETAILIDX_MAX_REGION * uint(COVERAGE_SURFACE_SLOTS)], redDetailIdx);
          InterlockedMax(SurfaceCoverageBuffer[COVERAGE_REDDETAILIDX_MIN_REGION * uint(COVERAGE_SURFACE_SLOTS)], COVERAGE_DETAILIDX_BIAS - min(redDetailIdx, COVERAGE_DETAILIDX_BIAS));
          InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_REDDETAIL_COUNT_REGION * uint(COVERAGE_SURFACE_SLOTS)], 1u);
        }
      }
    }
    // NV-DXVK [Coverage NaN]: per-surface count + screen bbox of NaN/Inf-albedo
    // primary hits. Placed OUTSIDE the dot>0.001 gate above because saturate(NaN)
    // ->0 fails that gate, so this is the only path that records them. CPU
    // readback groups region 48 by VS (like RawAlbedoColor) to name the shader,
    // and reads the bbox (49-52) to tell a fullscreen plane from a sub-mesh.
    if (covAlbedoIsBad)
    {
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_NAN_COUNT_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      const uint2 nanPix = getDispatchRaysIndex().xy;
      InterlockedMax(SurfaceCoverageBuffer[COVERAGE_NANSCR_MAXX_REGION * uint(COVERAGE_SURFACE_SLOTS)], nanPix.x);
      InterlockedMax(SurfaceCoverageBuffer[COVERAGE_NANSCR_MINX_REGION * uint(COVERAGE_SURFACE_SLOTS)], COVERAGE_REDSCR_BIAS - nanPix.x);
      InterlockedMax(SurfaceCoverageBuffer[COVERAGE_NANSCR_MAXY_REGION * uint(COVERAGE_SURFACE_SLOTS)], nanPix.y);
      InterlockedMax(SurfaceCoverageBuffer[COVERAGE_NANSCR_MINY_REGION * uint(COVERAGE_SURFACE_SLOTS)], COVERAGE_REDSCR_BIAS - nanPix.y);
    }
    // NV-DXVK [Coverage PureRed]: VALID-STAGE attribution of the (0.8,0,0) plane.
    // surfaceIndex here is guaranteed valid (this is the opaque RAW_ALBEDO write),
    // so VS attribution is trustworthy — unlike the aliased SharedSurfaceIndex the
    // postprocess co-samples. If region 56 stays ~empty while the screen is red,
    // the red pixels are NOT opaque hits (miss/sky), redirecting the search.
    if (covRawAlbedoF.r > 0.5f && covRawAlbedoF.g < 0.05f && covRawAlbedoF.b < 0.05f)
    {
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SURFACE_REGION * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_TOTAL], 1u);
      if (albedoOpacityLoaded) {
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_TEXLOADED], 1u);
      } else {
        InterlockedAdd(SurfaceCoverageBuffer[COVERAGE_PURERED_SUMMARY_REGION * uint(COVERAGE_SURFACE_SLOTS) + COVERAGE_PURERED_SLOT_TEXMISSING], 1u);
      }
    }
    // NV-DXVK [Coverage] regions 5..14 = blot-localization probes.
    // Region 5 (AlbedoDrift) is the end-to-end "encoded diverged from raw"
    // counter sorted desc to surface the worst VS. Regions 6-9 measure
    // *incremental* drift at each pipeline stage so we can identify WHICH
    // transform introduces the artifact:
    //   6 = DriftStageGamma     (postGamma - raw)
    //   7 = DriftStageScaleBias (postScaleBias - postGamma)
    //   8 = DriftStageMetallic  (postMetallic - postScaleBias)
    //   9 = DriftStageAdjusted  (final - postMetallic)
    // The stage with the highest count for a blot VS is the mechanism.
    // Regions 10-14 are *co-occurrence flags* that fire whenever the named
    // condition is true (regardless of drift) — comparing them to region 5
    // reveals which auxiliary branch coincides with the blot:
    //   10 = MetallicHigh       (metallic > 0.5)
    //   11 = OpacityLow         (opacity < 0.99)
    //   12 = IsMatteHits        (surface.isMatte fired — encoded forced to 0)
    //   13 = IsTf2SkyboxFogHits (TF2 fog reconstruction branch fired)
    //   14 = MetallicLoaded     (metallic-F0 lerp branch was entered)
    // Promote diffs to float for the squared-length tests so the 0.01
    // threshold doesn't hit fp16 quantization at small magnitudes.
    {
      const float3 finalAlbedo = float3(opaqueSurfaceMaterialInteraction.albedo);
      const float3 rawAlbedo = float3(covRawAlbedo);
      const float3 postGamma = float3(covPostGamma);
      const float3 postScaleBias = float3(covPostScaleBias);
      const float3 postMetallic = float3(covPostMetallic);

      // Region 5: end-to-end drift.
      {
        const float3 d = finalAlbedo - rawAlbedo;
        if (dot(d, d) > 0.01f)
        {
          InterlockedAdd(SurfaceCoverageBuffer[5u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        }
      }
      // Region 6: incremental drift introduced by gamma decode (+ stage A).
      {
        const float3 d = postGamma - rawAlbedo;
        if (dot(d, d) > 0.01f)
        {
          InterlockedAdd(SurfaceCoverageBuffer[6u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        }
      }
      // Region 7: incremental drift from material-args scale/bias (+ optional fog).
      {
        const float3 d = postScaleBias - postGamma;
        if (dot(d, d) > 0.01f)
        {
          InterlockedAdd(SurfaceCoverageBuffer[7u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        }
      }
      // Region 8: incremental drift from metallic-F0 lerp (prime suspect).
      {
        const float3 d = postMetallic - postScaleBias;
        if (dot(d, d) > 0.01f)
        {
          InterlockedAdd(SurfaceCoverageBuffer[8u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        }
      }
      // Region 9: incremental drift from albedoToAdjustedAlbedo opacity-fold
      // (also captures eye-override drift since that happens after the
      // adjustedAlbedo write and before this point).
      {
        const float3 d = finalAlbedo - postMetallic;
        if (dot(d, d) > 0.01f)
        {
          InterlockedAdd(SurfaceCoverageBuffer[9u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
        }
      }
      // Region 10: MetallicHigh flag. metallic value is fp16 0..1.
      if (float(metallic) > 0.5f)
      {
        InterlockedAdd(SurfaceCoverageBuffer[10u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      }
      // Region 11: OpacityLow flag.
      if (float(opacity) < 0.99f)
      {
        InterlockedAdd(SurfaceCoverageBuffer[11u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      }
      // Region 12: IsMatteHits flag — counts pixels where the matte branch
      // forced encoded.albedo to zero. Use the local `surface` parameter.
      if (surface.isMatte)
      {
        InterlockedAdd(SurfaceCoverageBuffer[12u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      }
      // Region 13: IsTf2SkyboxFogHits flag.
      if (surface.isTf2SkyboxFog)
      {
        InterlockedAdd(SurfaceCoverageBuffer[13u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      }
      // Region 14: MetallicLoaded flag — fires whenever the metallic-F0
      // lerp branch was actually entered (vs falling back to material
      // constant). Lets us distinguish "metallic-F0 lerp didn't run, so
      // it isn't the cause" from "lerp ran but didn't push albedo far".
      if (metallicLoaded)
      {
        InterlockedAdd(SurfaceCoverageBuffer[14u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      }
      // Region 15: FlagPremultSet — diagnostic. Counts pixels where the
      // OPAQUE_SURFACE_MATERIAL_FLAG_ALBEDO_IS_PREMULTIPLIED bit is actually
      // set in the GPU material data. This is the definitive proof that the
      // C++ plumb chain (FillMaterialData → as<OpaqueMaterialData>() →
      // RtOpaqueSurfaceMaterial::writeGPUData) is delivering the bit. If
      // this region is empty for a VS we expect to be premult (e.g.
      // VS 0x2904d2163ef31a17 cloud), the CPU plumb is broken upstream.
      // If it fires but the AlbedoDrift / DriftStageAdjusted regions still
      // show drift for that VS, the slang branch above isn't doing what we
      // think — investigate the ternary / type conversions.
      if ((opaqueSurfaceMaterial.flags & OPAQUE_SURFACE_MATERIAL_FLAG_ALBEDO_IS_PREMULTIPLIED) != 0u)
      {
        InterlockedAdd(SurfaceCoverageBuffer[15u * uint(COVERAGE_SURFACE_SLOTS) + inCovSurfaceIndex], 1u);
      }
    }
  }
  // NV-DXVK [Coverage]: per-call-site orphan counter. Threshold is the
  // CURRENT frame's reordered surface count (cb.surfaceCount = same value
  // as CPU getSurfaceCount() = m_reorderedSurfaces.size()), so any hit at
  // surfaceIndex >= cb.surfaceCount is *definitionally* an orphan from a
  // prior frame's layout — there are no instances at that index this
  // frame. Fixed thresholds (512, etc.) miss in-range-stale cases where
  // current orderedSize is e.g. 120 but a stale orphan at index 85
  // exists. Writes to region 4 at slot=siteId; readback dumps per-site
  // counts.
  if (inCovSurfaceIndex >= cb.surfaceCount)
  {
    const uint siteSlot = (inCovCallSiteId < 16u) ? inCovCallSiteId : 15u;
    InterlockedAdd(SurfaceCoverageBuffer[4u * uint(COVERAGE_SURFACE_SLOTS) + siteSlot], 1u);
  }
#endif

  return opaqueSurfaceMaterialInteraction;
}

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction)
{
  // Decode the Opaque Surface Material Interaction from its polymorphic representation
  // Note: Opaque type is known in advance

  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;

  opaqueSurfaceMaterialInteraction.shadingNormal = polymorphicSurfaceMaterialInteraction.shadingNormal;
  opaqueSurfaceMaterialInteraction.emissiveRadiance = polymorphicSurfaceMaterialInteraction.emissiveRadiance;
  opaqueSurfaceMaterialInteraction.albedo = polymorphicSurfaceMaterialInteraction.vdata0;
  opaqueSurfaceMaterialInteraction.baseReflectivity = polymorphicSurfaceMaterialInteraction.vdata1;

  if (polymorphicSurfaceMaterialInteraction.fdata0 < 0.0)
  {
    opaqueSurfaceMaterialInteraction.opacity = 1.0;
    opaqueSurfaceMaterialInteraction.thinFilmThickness = -polymorphicSurfaceMaterialInteraction.fdata0;
  }
  else
  {
    opaqueSurfaceMaterialInteraction.opacity = polymorphicSurfaceMaterialInteraction.fdata0;
    opaqueSurfaceMaterialInteraction.thinFilmThickness = 0.0;
  }
  
  opaqueSurfaceMaterialInteraction.isotropicRoughness = polymorphicSurfaceMaterialInteraction.fdata1;
  opaqueSurfaceMaterialInteraction.anisotropicRoughness.x = polymorphicSurfaceMaterialInteraction.fdata2;
  opaqueSurfaceMaterialInteraction.anisotropicRoughness.y = polymorphicSurfaceMaterialInteraction.fdata3;
  opaqueSurfaceMaterialInteraction.normalDetail = polymorphicSurfaceMaterialInteraction.fdata4;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.measurementDistance = polymorphicSurfaceMaterialInteraction.fdata5;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.volumetricAnisotropy = polymorphicSurfaceMaterialInteraction.bdata1;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.maxSampleRadius = polymorphicSurfaceMaterialInteraction.bdata2;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.packedTransmittanceColor = polymorphicSurfaceMaterialInteraction.i32data0;
  opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction.packedSingleScatteringAlbedo = polymorphicSurfaceMaterialInteraction.i32data1;

  opaqueSurfaceMaterialInteraction.flags = polymorphicSurfaceMaterialInteraction.bdata0;

  return opaqueSurfaceMaterialInteraction;
}

OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(
  GBufferMemoryPolymorphicSurfaceMaterialInteraction gBufferMemoryPolymorphicSurfaceMaterialInteraction)
{
  // Decode the Opaque Surface Material Interaction from its polymorphic GBuffer Memory representation
  // Note: Opaque type is known in advance

  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction;

  const uint data0 = gBufferMemoryPolymorphicSurfaceMaterialInteraction.data0;
  const uint data1 = gBufferMemoryPolymorphicSurfaceMaterialInteraction.data1;

  const float16_t perceptualRoughness = gBufferMemoryPolymorphicSurfaceMaterialInteraction.perceptualRoughness;
  const float16_t sourceAnisotropy = snorm8ToF16(uint8_t(data0 >> 0));
  const float16_t opacityOrThinFilmThickness = unorm8ToF16(uint8_t(data0 >> 8));
  const uint8_t flagsAndType = uint8_t(data0 >> 24);
  const f16vec3 gammaEmissiveColor = f16vec3(
    unorm8ToF16(uint8_t(data0 >> 16)),
    unorm8ToF16(uint8_t(data1 >> 0)),
    unorm8ToF16(uint8_t(data1 >> 8)));
  const f16vec3 emissiveColor = gammaToLinearFast(gammaEmissiveColor);
  const float16_t emissiveIntensity = uint16BitsToHalf(uint16_t(data1 >> 16));

  float16_t isotropicRoughness;
  f16vec2 anisotropicRoughness;

  opaqueSurfaceMaterialInteraction.flags = flagsAndType & OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_MASK;
  const bool thinFilmEnabled = (flagsAndType & OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_USE_THIN_FILM_LAYER);

  calcRoughness(perceptualRoughness, sourceAnisotropy, isotropicRoughness, anisotropicRoughness);

  opaqueSurfaceMaterialInteraction.shadingNormal = gBufferMemoryPolymorphicSurfaceMaterialInteraction.worldShadingNormal;

  opaqueSurfaceMaterialInteraction.albedo = gBufferMemoryPolymorphicSurfaceMaterialInteraction.albedo;
  // Note: Opacity set to 1 when thin film is enabled (as we unfortunately cannot read from the opacity constant here and there
  // is no extra room in this GBuffer encoding to store both the opacity and the thin film thickness).
  opaqueSurfaceMaterialInteraction.opacity = thinFilmEnabled ? float16_t(1.0f) : opacityOrThinFilmThickness;
  opaqueSurfaceMaterialInteraction.baseReflectivity = gBufferMemoryPolymorphicSurfaceMaterialInteraction.baseReflectivity;
  opaqueSurfaceMaterialInteraction.isotropicRoughness = isotropicRoughness;
  opaqueSurfaceMaterialInteraction.anisotropicRoughness = anisotropicRoughness;
  opaqueSurfaceMaterialInteraction.emissiveRadiance = emissiveColor * emissiveIntensity;
  // Note: Thickness set to 0 when thin film is disabled for the same reason the opacity is set to 1 when it is enabled.
  opaqueSurfaceMaterialInteraction.thinFilmThickness = thinFilmEnabled ? opacityOrThinFilmThickness : float16_t(0.0f);

  // We don't store this in the G-buffer
  opaqueSurfaceMaterialInteraction.normalDetail = float16_t(0.0f);

  // Note thin opaque properties are stored later into PolymorphicSurfaceMaterialInteraction

  return opaqueSurfaceMaterialInteraction;
}

SurfaceMaterialInteractionLobeInformation opaqueSurfaceMaterialInteractionGetLobeInformation(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  SurfaceMaterialInteractionLobeInformation surfaceMaterialInteractionLobeInformation;

  surfaceMaterialInteractionLobeInformation.diffuseReflectionPresent =
    any(greaterThanEqual(opaqueSurfaceMaterialInteraction.albedo, albedoThreshold));
  surfaceMaterialInteractionLobeInformation.specularReflectionPresent =
    any(greaterThanEqual(opaqueSurfaceMaterialInteraction.baseReflectivity, baseReflectivityThreshold));
  surfaceMaterialInteractionLobeInformation.diffuseTransmissionPresent = false;
  surfaceMaterialInteractionLobeInformation.specularTransmissionPresent = false;

  surfaceMaterialInteractionLobeInformation.specularReflectionDirac =
    opaqueSurfaceMaterialInteraction.isotropicRoughness < roughnessThreshold;
  surfaceMaterialInteractionLobeInformation.specularTransmissionDirac = false;

  return surfaceMaterialInteractionLobeInformation;
}

bool opaqueSurfaceMaterialInteractionCalcLobeProbability(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  f16vec3 viewDirection,
  out float16_t diffuseReflectionProbability,
  out float16_t specularReflectionProbability,
  out float16_t opacityTransmissionProbability,
  out float16_t diffuseTransmissionProbability)
{
  const bool isThinOpaqueSubsurface = isThinOpaqueSubsurfaceMaterial(opaqueSurfaceMaterialInteraction);

  // Calculate dot products used for evaluation

  // Note: Normal dot output direction used as a "best" approximation in this case, usually aligned with the actual sampled
  // microfacet normal on surfaces with low roughness (identical at 0), but will become more and more potentially inaccurate
  // as roughness increases.
  const float16_t /* n.v */ normalDotOutputDirection =
    dot(opaqueSurfaceMaterialInteraction.shadingNormal, viewDirection);

  // Compute material-related quantities

  // Note: Albedo and Base Reflectivity already have opacity baked into them which is why opacity does not need to be specified
  // in the albedo approximations below.
  const f16vec3 albedo = opaqueSurfaceMaterialInteraction.albedo;
  const f16vec3 fresnel =
    evalOpaqueSchlickFresnel(opaqueSurfaceMaterialInteraction.baseReflectivity, normalDotOutputDirection);

  // Note: I think these should be using a preintegrated albedo calculation (e.g. the EnvBRDF approximation for specular
  // albedo), but I am not 100% sure if that is the intended "ideal" quantity to be using for a lobe's weight (when only the outgoing
  // view direction is known, not the yet to be sampled input direction). For now, just using simplified albedo approximations as these
  // at least directly cancel with terms in the BRDF which should help reduce variance a little.
  // Note: Perceptual luminance also used to reduce tristimulus color to a single probability value to hopefully look better to
  // the human eye than a simple average. This is done at the very end of calculations so that interactions between colors take
  // effect rather than being reduced to a single value too soon.
  const float16_t diffuseReflectionAlbedoApprox = calcBt709Luminance((f16vec3(1.0h) - fresnel) * albedo);
  const float16_t specularReflectionAlbedoApprox = calcBt709Luminance(fresnel);
  const float16_t opacityTransmissionAlbedoApprox = 1.0h - opaqueSurfaceMaterialInteraction.opacity;
  const float16_t diffuseTransmissionAlbedoApprox = calcBt709Luminance(f16vec3(1.0h) - fresnel);

  // Calculate lobe probabilities

  diffuseReflectionProbability = diffuseReflectionAlbedoApprox;
  specularReflectionProbability = specularReflectionAlbedoApprox;
  opacityTransmissionProbability = opacityTransmissionAlbedoApprox;
  diffuseTransmissionProbability = isThinOpaqueSubsurface ? diffuseTransmissionAlbedoApprox : 0.0h;

  // Todo: Pass raytraceArgs in in the future if accessing these constants poses a problem later.
  adjustProbabilityValue(
    diffuseReflectionProbability,
    uint16BitsToHalf(cb.opaqueDiffuseLobeSamplingProbabilityZeroThreshold),
    uint16BitsToHalf(cb.minOpaqueDiffuseLobeSamplingProbability));
  adjustProbabilityValue(
    specularReflectionProbability,
    uint16BitsToHalf(cb.opaqueSpecularLobeSamplingProbabilityZeroThreshold),
    uint16BitsToHalf(cb.minOpaqueSpecularLobeSamplingProbability));
  adjustProbabilityValue(
    opacityTransmissionProbability,
    uint16BitsToHalf(cb.opaqueOpacityTransmissionLobeSamplingProbabilityZeroThreshold),
    uint16BitsToHalf(cb.minOpaqueOpacityTransmissionLobeSamplingProbability));
  adjustProbabilityValue(
    diffuseTransmissionProbability,
    uint16BitsToHalf(cb.opaqueDiffuseTransmissionLobeSamplingProbabilityZeroThreshold),
    uint16BitsToHalf(cb.minOpaqueDiffuseTransmissionLobeSamplingProbability));

  const float16_t lobeProbabilitySum =
    opacityTransmissionProbability +
    diffuseTransmissionProbability +
    specularReflectionProbability +
    diffuseReflectionProbability;

  if (lobeProbabilitySum == 0.0h)
  {
    return false;
  }

  const float16_t lobeProbabilityNormalizationFactor = 1.0h / lobeProbabilitySum;

  diffuseReflectionProbability *= lobeProbabilityNormalizationFactor;
  specularReflectionProbability *= lobeProbabilityNormalizationFactor;
  opacityTransmissionProbability *= lobeProbabilityNormalizationFactor;
  diffuseTransmissionProbability *= lobeProbabilityNormalizationFactor;

  return true;
}

SurfaceMaterialInteractionLobeSample opaqueSurfaceMaterialInteractionCalcLobeSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  float16_t random,
  MinimalRayInteraction minimalRayInteraction,
  inout bool insideMedium)
{
  unused(insideMedium);

  float16_t diffuseReflectionProbability = 0.0h;
  float16_t specularReflectionProbability = 0.0h;
  float16_t opacityTransmissionProbability = 0.0h;
  float16_t diffuseTransmissionProbability = 0.0h;

  const bool isValid = opaqueSurfaceMaterialInteractionCalcLobeProbability(
    opaqueSurfaceMaterialInteraction, minimalRayInteraction.viewDirection,
    diffuseReflectionProbability, specularReflectionProbability, opacityTransmissionProbability, diffuseTransmissionProbability);

  SurfaceMaterialInteractionLobeSample surfaceMaterialInteractionLobeSample;

  if (!isValid)
  {
    // Note: Default to sampling specular lobe when no lobe desires to be sampled from. Ideally this could just be skipped entirely as
    // a sample though, but we currently do not support that logic, so for now we pick specular since it will generate more coherent
    // rays ideally to minimize the performance impact.
    surfaceMaterialInteractionLobeSample.lobe = opaqueLobeTypeSpecularReflection;
    surfaceMaterialInteractionLobeSample.pdf = 0.0h;

    return surfaceMaterialInteractionLobeSample;
  }

  // Sample a lobe

  const float16_t lobeSample = random;

  // Note: < used for conditions to ensure lobes never have a chance to be sampled from if their
  // probability is 0 (and to prevent NaNs from appearing due to 0 PDF).
  if (lobeSample < opacityTransmissionProbability)
  {
    surfaceMaterialInteractionLobeSample.lobe = opaqueLobeTypeOpacityTransmission;
    surfaceMaterialInteractionLobeSample.pdf = opacityTransmissionProbability;
  }
  else if (lobeSample < (opacityTransmissionProbability + diffuseTransmissionProbability)) {
    surfaceMaterialInteractionLobeSample.lobe = opaqueLobeTypeDiffuseTransmission;
    surfaceMaterialInteractionLobeSample.pdf = diffuseTransmissionProbability;
  }
  else if (lobeSample < (opacityTransmissionProbability + diffuseTransmissionProbability + specularReflectionProbability))
  {
    surfaceMaterialInteractionLobeSample.lobe = opaqueLobeTypeSpecularReflection;
    surfaceMaterialInteractionLobeSample.pdf = specularReflectionProbability;
  }
  else
  {
    surfaceMaterialInteractionLobeSample.lobe = opaqueLobeTypeDiffuseReflection;
    surfaceMaterialInteractionLobeSample.pdf = diffuseReflectionProbability;
  }

  return surfaceMaterialInteractionLobeSample;
}

SurfaceMaterialInteractionSample opaqueSurfaceMaterialInteractionCalcDiffuseReflectionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  inout RNG randomState,
  f16vec4 tangentToWorldSpaceQuaternion,
  MinimalRayInteraction minimalRayInteraction)
{
  const f16vec4 worldToTangentSpaceQuaternion = quaternionInverse(tangentToWorldSpaceQuaternion);

  // Set up relevant input vectors in tangent space

  const f16vec3 outputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, minimalRayInteraction.viewDirection);

  // Sample a new input direction based on a cosine weighted hemisphere

  const f16vec2 u = f16vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState));
  float cosineHemisphereSolidAnglePdf;
  const f16vec3 inputDirection = calcCosineHemisphereDirectionSample(u, cosineHemisphereSolidAnglePdf);

  // Todo: Sanity check if inputDirection is facing the wrong direction (Into the surface), currently this does not have much
  // effect and getting the triangle normal here requires a fairly high memory bandwidth cost, so for now it is not done

  // Calculate the microfacet normal from the input and output directions

  const f16vec3 microfacetNormal = normalize(outputDirection + inputDirection);

  // Calculate dot products used for evaluation
  // Note: Dot products against tangent space basis vectors are single components of the other vector

  const float16_t /* l.v */ inputDirectionDotOutputDirection = dot(inputDirection, outputDirection);
  const float16_t /* n.l */ normalDotInputDirection = inputDirection.z;
  const float16_t /* n.v */ normalDotOutputDirection = outputDirection.z;
  const float16_t /* n.h */ normalDotMicrofacetNormal = microfacetNormal.z;

  // Check if the sampled direction is valid
  // Note: Also checking the output direction here, in theory this should be valid with pure triangle normals, but normal maps
  // allow for surfaces to be viewed from outside the actual normal's hemisphere, resulting in an invalid sample.
  // Note: Input direction check here is currently not needed, diffuse sampling should always produce sampled directions valid within
  // the normal's hemisphere, but just kept here in case the sampling changes some day.

  // Note: < used rather than <= as parallel vectors to the triangle normal can be considered in the hemisphere without colliding
  // with the triangle. Convention can vary but in this case cosine sampling can produce parallel directions like this at times
  // so it's better to not reject those samples.
  if (normalDotOutputDirection < 0.0h || normalDotInputDirection < 0.0h)
  {
    SurfaceMaterialInteractionSample materialSample;

    materialSample.inputDirection = f16vec3(0.0, 0.0, 0.0);
    materialSample.throughput = f16vec3(0.0, 0.0, 0.0);
    materialSample.solidAnglePdf = 0.0f;

    return materialSample;
  }
  
  // Calculate the throughput of the sample

  const SubsurfaceMaterial subsurfaceMaterial = subsurfaceMaterialCreate(opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction);
  const bool isThinOpaqueSubsurface = isThinOpaqueSubsurfaceMaterial(opaqueSurfaceMaterialInteraction);

  // If we have lambert diffuse transmission lobe, we are actually doing lambert sampling on the whole sphere, so the diffuse reflection weight should be weighted with 1/2pi for energy conservation.
  // The original hammon diffuse does sampling on hemisphere, so we can just normalize the weight again with 1/2.
  const f16vec3 lambertTransmissionWeight = (isThinOpaqueSubsurface && subsurfaceMaterial.measurementDistance <= 0.05f) ? 0.5h : 1.0h;

  const f16vec3 weight =
    evalHammonDiffuse(opaqueSurfaceMaterialInteraction.albedo, opaqueSurfaceMaterialInteraction.isotropicRoughness,
      inputDirectionDotOutputDirection, normalDotInputDirection,
      normalDotOutputDirection, normalDotMicrofacetNormal) * lambertTransmissionWeight;
  const f16vec3 throughput =
    saferPositiveDivide(weight, f16vec3(cosineHemisphereSolidAnglePdf), materialEpsilon, materialMaximum) *
    normalDotInputDirection;

  // Return the material sample

  SurfaceMaterialInteractionSample materialSample;

  materialSample.inputDirection = quaternionTransformVector(tangentToWorldSpaceQuaternion, inputDirection);
  materialSample.throughput = throughput;
  materialSample.solidAnglePdf = cosineHemisphereSolidAnglePdf;

  return materialSample;
}

SurfaceMaterialInteractionSample opaqueSurfaceMaterialInteractionCalcSpecularReflectionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  inout RNG randomState,
  f16vec4 tangentToWorldSpaceQuaternion,
  MinimalRayInteraction minimalRayInteraction)
{
  const f16vec4 worldToTangentSpaceQuaternion = quaternionInverse(tangentToWorldSpaceQuaternion);

  // Set up relevant input vectors in tangent space

  const f16vec3 outputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, minimalRayInteraction.viewDirection);

  // Sample a new microfacet normal based on the distribution of visible normals

  const f16vec2 u = f16vec2(
    getNextSampleBlueNoise(randomState),
    getNextSampleBlueNoise(randomState));

#if OPAQUE_MATERIAL_USE_BOUNDED_VNDF_SAMPLING
  // Note: Manually calculate the lower bound scaling constant rather than using the usual calcGGXBoundedVisibleNormalDistributionSample
  // helper function. This is done so that this k value only needs to be computed once, as it is also needed for how the PDF is calculated
  // later (which is worked into the throughput math here).
  const float16_t k = calcBoundedVNDFLowerBoundScalar(opaqueSurfaceMaterialInteraction.anisotropicRoughness, outputDirection);

  const f16vec3 microfacetNormal = calcGGXVisibleNormalDistributionSphericalCapSample(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    outputDirection,
    u,
    k);
#else
  const f16vec3 microfacetNormal = calcGGXVisibleNormalDistributionSample(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    outputDirection,
    u);
#endif

  // Reflect the output direction across the microfacet normal to get the input direction

  const f16vec3 inputDirection = reflect(-outputDirection, microfacetNormal);

  // Todo: Sanity check if inputDirection is facing the wrong direction (Into the surface), currently this does not have much
  // effect and getting the triangle normal here requires a fairly high memory bandwidth cost, so for now it is not done

  // Calculate dot products used for evaluation
  // Note: Dot products against tangent space basis vectors are single components of the other vector

  const float16_t /* v.h */ outputDirectionDotMicrofacetNormal = dot(outputDirection, microfacetNormal);
  const float16_t /* t.v */ tangentDotOutputDirection = outputDirection.x;
  const float16_t /* b.v */ bitangentDotOutputDirection = outputDirection.y;
  const float16_t /* n.v */ normalDotOutputDirection = outputDirection.z;
  const float16_t /* t.l */ tangentDotInputDirection = inputDirection.x;
  const float16_t /* b.l */ bitangentDotInputDirection = inputDirection.y;
  const float16_t /* n.l */ normalDotInputDirection = inputDirection.z;
  const float16_t /* t.h */ tangentDotMicrofacetNormal = microfacetNormal.x;
  const float16_t /* b.h */ bitangentDotMicrofacetNormal = microfacetNormal.y;
  const float16_t /* n.h */ normalDotMicrofacetNormal = microfacetNormal.z;

  // Check if the sampled direction is valid
  // Note: Also checking the output direction here, in theory this should be valid with pure triangle normals, but normal maps
  // allow for surfaces to be viewed from outside the actual normal's hemisphere, resulting in an invalid sample. Additionally,
  // while bounded VNDF sampling does not produce any invalid directions outside the normal's hemisphere in normal cases, it
  // is not tightly bounded in cases with anisotropy, so this check is still needed. If a tighter bound is found in the future
  // which handles anisotropy as well though, the sampled reflected direction check may be able to be removed.

  // Note: < used rather than <= as parallel vectors to the triangle normal can be considered in the hemisphere without colliding
  // with the triangle. Convention can vary but using this here to be consistent with diffuse sampling.
  if (normalDotOutputDirection < 0.0h || normalDotInputDirection < 0.0h)
  {
    SurfaceMaterialInteractionSample materialSample;

    materialSample.inputDirection = f16vec3(0.0, 0.0, 0.0);
    materialSample.throughput = f16vec3(0.0, 0.0, 0.0);
    materialSample.solidAnglePdf = 0.0f;

    return materialSample;
  }

  // Calculate the throughput of the sample

  const f16vec3 fresnel = evalOpaqueSchlickFresnel(
    opaqueSurfaceMaterialInteraction.baseReflectivity, outputDirectionDotMicrofacetNormal);

  // Todo: Pass in a material mode similar to the resolve mode to control this sort of material simplification option.
#ifdef OPAQUE_MATERIAL_USE_THIN_FILM
  // Note: Compute an approximate refractive index for the material for the thin film math, currently assuming the opaque material is always
  // surrounded by a vacuum (not true in all cases but good enough for this approximation).
  const float16_t refractiveIndex = baseReflectivityToIoR(
    materialIoRVacuum, calcBt709Luminance(opaqueSurfaceMaterialInteraction.baseReflectivity));
  const bool useThinFilm = opaqueSurfaceMaterialInteraction.thinFilmThickness > 0.0;
  const float16_t thinFilmThickness = opaqueSurfaceMaterialInteraction.thinFilmThickness * OPAQUE_SURFACE_MATERIAL_THIN_FILM_MAX_THICKNESS; // convert [0,1] range to nm
  // Note: Matching the refractive index calculation, compute the thin film assuming the material is surrounded by a vacuum and with a fixed layer IoR.
  const f16vec3 thinFilmFresnel = evalThinFilmFresnel(
    materialIoRVacuum, materialIoRThinFilmLayer, refractiveIndex,
    thinFilmThickness, outputDirectionDotMicrofacetNormal);

  const f16vec3 finalFresnel = useThinFilm ? thinFilmFresnel : fresnel;
#else
  const f16vec3 finalFresnel = fresnel;
#endif

#if OPAQUE_MATERIAL_USE_BOUNDED_VNDF_SAMPLING
  // Note: More typical G2/G1 calculation with special bounded G1 using the bounded scalar k calculated earlier for sampling
  // the bounded VNDF lobe. This must be done instead of the usual G2/G1 optimization as the bounding of G1 does not allow for
  // the same mathematical optimization to be performed.
  const float16_t G2 = evalHeightCorrelatedGGXShadowingMasking(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotInputDirection, tangentDotOutputDirection,
    bitangentDotInputDirection, bitangentDotOutputDirection,
    normalDotInputDirection, normalDotOutputDirection);
  const float16_t G1 = evalGGXShadowing(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotOutputDirection, bitangentDotOutputDirection, normalDotOutputDirection,
    k);
  const float16_t G2OverG1 = saferPositiveDivide(G2, G1, materialEpsilon, materialMaximum);
#else
  // Note: Algebraic simplification of height correlated G2/G1 to reduce evaluation cost. Could be simplified a bit further
  // I think however by calculating lambda for the input/output directions and evaluating (1 + L(O)) / (1 + L(O) + L(I)) as
  // this would avoid a multiplication, but may not benefit from the somewhat simplified G1 form itself. Also note that the paper
  // this is from uses w_i for the view direction (output direction in our case) and w_o for the light direction which can be a bit
  // confusing since it is backwards from our notation.
  // [Heitz 2015, "Implementing a Simple Anisotropic Rough Diffuse Material with Stochastic Evaluation"]
  const float16_t outputGGXShadowing = evalGGXShadowing(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotOutputDirection, bitangentDotOutputDirection, normalDotOutputDirection);
  const float16_t inputGGXShadowing = evalGGXShadowing(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotInputDirection, bitangentDotInputDirection, normalDotInputDirection);
  const float16_t G2OverG1 = safePositiveDivide(
    inputGGXShadowing,
    inputGGXShadowing + outputGGXShadowing - (inputGGXShadowing * outputGGXShadowing),
    materialEpsilon);
#endif
  // Note: Simplified version of (weight / solidAnglePdf) * (n.l) when sampling from the distribution of
  // visible normals.
  // [Heitz 2014, "Importance sampling microfacet-based BSDFs using the distribution of visible normals"]
  const f16vec3 throughput = finalFresnel * G2OverG1;

  // Calculate the solid angle PDF of the sample
  // Note: Ideally the PDF wouldn't be needed here as it's already been baked into the throughput for a simpler calculation
  // but some logic needs the PDF so it is included here for those cases (whereas others can optimize this part out).
  // Todo: Reuse the G1 calculation from earlier in this PDF rather than redundantly recalculating it (as G1
  // is part of the VNDF PDF).

#if OPAQUE_MATERIAL_USE_BOUNDED_VNDF_SAMPLING
  // Note: Normal version instead of evalGGXBoundedVisibleNormalDistributionSamplePdf used here so that the shared k
  // value computed from earlier can be used here to save some computation. Note that really the entire G1 function
  // evaluation can be shared between the throughput calculation and the PDF here.
  const float solidAnglePdf = evalGGXVisibleNormalDistributionSamplePdf(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotOutputDirection, bitangentDotOutputDirection, normalDotOutputDirection,
    tangentDotMicrofacetNormal, bitangentDotMicrofacetNormal, normalDotMicrofacetNormal,
    outputDirectionDotMicrofacetNormal,
    k);
#else
  const float solidAnglePdf = evalGGXVisibleNormalDistributionSamplePdf(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotOutputDirection, bitangentDotOutputDirection, normalDotOutputDirection,
    tangentDotMicrofacetNormal, bitangentDotMicrofacetNormal, normalDotMicrofacetNormal,
    outputDirectionDotMicrofacetNormal);
#endif

  // Return the material sample

  SurfaceMaterialInteractionSample materialSample;

  materialSample.inputDirection = quaternionTransformVector(tangentToWorldSpaceQuaternion, inputDirection);
  materialSample.throughput = throughput;
  materialSample.solidAnglePdf = solidAnglePdf;

  return materialSample;
}

SurfaceMaterialInteractionSample opaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  inout RNG randomState,
  f16vec4 tangentToWorldSpaceQuaternion,
  MinimalRayInteraction minimalRayInteraction,
  inout bool insideMedium, inout bool penetrateSurface)
{
  unused(insideMedium);
  
  const f16vec4 worldToTangentSpaceQuaternion = quaternionInverse(tangentToWorldSpaceQuaternion);

  // Set up relevant input vectors in tangent space

  const f16vec3 outputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, minimalRayInteraction.viewDirection);

  const f16vec2 u = f16vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState));
  float cosineHemisphereSolidAnglePdf = 0.0f;
  f16vec3 inputDirection = -calcCosineHemisphereDirectionSample(u, cosineHemisphereSolidAnglePdf);

  const float16_t /* l.h */ inputDirectionDotMicrofacetNormal = -inputDirection.z;
  const float16_t /* o.h */ outputDirectionDotMicrofacetNormal = outputDirection.z;

  const f16vec3 fresnel = evalOpaqueSchlickFresnel(
    opaqueSurfaceMaterialInteraction.baseReflectivity, outputDirectionDotMicrofacetNormal);
  const f16vec3 transmissionFresnel = f16vec3(1.0h, 1.0h, 1.0h) - fresnel;

  SurfaceMaterialInteractionSample materialSample;
  materialSample.inputDirection = quaternionTransformVector(tangentToWorldSpaceQuaternion, inputDirection);
  materialSample.throughput = safePositiveDivide(transmissionFresnel * opaqueSurfaceMaterialInteraction.albedo * rcp(twoPi), f16vec3(cosineHemisphereSolidAnglePdf), materialEpsilon) * inputDirectionDotMicrofacetNormal;
  materialSample.solidAnglePdf = cosineHemisphereSolidAnglePdf;

  // Note: Transmission rays penetrate the surface like translucent materials.
  penetrateSurface = true;

  return materialSample;
}

SurfaceMaterialInteractionSample thinOpaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  inout RNG randomState,
  f16vec4 tangentToWorldSpaceQuaternion,
  MinimalRayInteraction minimalRayInteraction,
  SubsurfaceMaterial subsurfaceMaterial,
  inout bool insideMedium, inout bool penetrateSurface)
{
  unused(insideMedium);
  
  const f16vec4 worldToTangentSpaceQuaternion = quaternionInverse(tangentToWorldSpaceQuaternion);

  // Set up relevant input vectors in tangent space

  const f16vec3 outputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, minimalRayInteraction.viewDirection);

  const f16vec2 u = f16vec2(getNextSampleBlueNoise(randomState), getNextSampleBlueNoise(randomState));
  float cosineHemisphereSolidAnglePdf = 0.0f;
  const f16vec3 inputDirection = -calcCosineHemisphereDirectionSample(u, cosineHemisphereSolidAnglePdf);

  const float16_t /* n.v */ normalDotOutputDirection = outputDirection.z;
  // Note: Negative as input direction always points into surface
  const float16_t /*-n.l */ transmissionNormalDotInputDirection = -inputDirection.z;
  const float16_t /* v.l */ inputDirectionDotOutputDirection = dot(-outputDirection, inputDirection);

  const f16vec3 weight = evalHanrahanSingleScatteringDiffuseTransmission(
    opaqueSurfaceMaterialInteraction.baseReflectivity,
    subsurfaceMaterial.volumetricAttenuationCoefficient, subsurfaceMaterial.measurementDistance,
    subsurfaceMaterial.singleScatteringAlbedo, subsurfaceMaterial.volumetricAnisotropy,
    normalDotOutputDirection,
    transmissionNormalDotInputDirection,
    inputDirectionDotOutputDirection);

  if (all(weight == 0.0h))
  {
    SurfaceMaterialInteractionSample materialSample;
    materialSample.inputDirection = f16vec3(0.0h, 0.0h, 0.0h);
    materialSample.throughput = f16vec3(0.0h, 0.0h, 0.0h);
    materialSample.solidAnglePdf = 0.0h;

    penetrateSurface = false;

    return materialSample;
  }

  SurfaceMaterialInteractionSample materialSample;
  materialSample.inputDirection = quaternionTransformVector(tangentToWorldSpaceQuaternion, inputDirection);
  materialSample.throughput = safePositiveDivide(weight, f16vec3(cosineHemisphereSolidAnglePdf), materialEpsilon) * transmissionNormalDotInputDirection;
  materialSample.solidAnglePdf = cosineHemisphereSolidAnglePdf;

  // Note: Transmission rays penetrate the surface like translucent materials.
  penetrateSurface = true;

  return materialSample;
}

// Note: Special case lobe for opacity.
SurfaceMaterialInteractionSample opaqueSurfaceMaterialInteractionCalcOpacityTransmissionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  inout bool insideMedium, inout bool penetrateSurface)
{
  unused(insideMedium);
  
  SurfaceMaterialInteractionSample materialSample;

  materialSample.inputDirection = -minimalRayInteraction.viewDirection;
  materialSample.throughput = f16vec3(
    float16_t(1.0f) - opaqueSurfaceMaterialInteraction.opacity,
    float16_t(1.0f) - opaqueSurfaceMaterialInteraction.opacity,
    float16_t(1.0f) - opaqueSurfaceMaterialInteraction.opacity);
  // Note: Dirac delta PDF, always a probability of 1 to sample this singular direction.
  materialSample.solidAnglePdf = 1.0f;

  // Note: Opacity rays penetrate the surface like translucent materials.
  penetrateSurface = true;

  return materialSample;
}

void opaqueSurfaceMaterialInteractionCalcSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  float16_t lobeRandom,
  inout RNG randomState,
  f16vec4 tangentToWorldSpaceQuaternion,
  MinimalRayInteraction minimalRayInteraction,
  inout SurfaceMaterialInteractionSample surfaceMaterialInteractionSample,
  inout SurfaceMaterialInteractionLobeSample surfaceMaterialInteractionLobeSample,
  inout bool insideMedium, inout bool penetrateSurface)
{
  surfaceMaterialInteractionLobeSample = opaqueSurfaceMaterialInteractionCalcLobeSample(
    opaqueSurfaceMaterialInteraction, lobeRandom, minimalRayInteraction, insideMedium);

  switch (uint(surfaceMaterialInteractionLobeSample.lobe))
  {
  default:
  case uint(opaqueLobeTypeDiffuseReflection):
    surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcDiffuseReflectionSample(
      opaqueSurfaceMaterialInteraction, randomState, tangentToWorldSpaceQuaternion, minimalRayInteraction);

    break;
  case uint(opaqueLobeTypeSpecularReflection):
    surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcSpecularReflectionSample(
      opaqueSurfaceMaterialInteraction, randomState, tangentToWorldSpaceQuaternion, minimalRayInteraction);

    break;
  case uint(opaqueLobeTypeOpacityTransmission):
    surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcOpacityTransmissionSample(
      opaqueSurfaceMaterialInteraction, minimalRayInteraction, insideMedium, penetrateSurface);

    break;
  case uint(opaqueLobeTypeDiffuseTransmission):
    // Load Subsurface Material
    const SubsurfaceMaterial subsurfaceMaterial = subsurfaceMaterialCreate(opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction);

    // When the thickness of surface is thinner than this experimental threshold, we don't need to consider the volume of the surface.
    // Instead, we use a cheaper 2-side sampling method with traditional LambertBTDF to simulate the effect.
    if (subsurfaceMaterial.measurementDistance > 0.05f)
    {
      surfaceMaterialInteractionSample = thinOpaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSample(
        opaqueSurfaceMaterialInteraction, randomState, tangentToWorldSpaceQuaternion, minimalRayInteraction, subsurfaceMaterial, insideMedium, penetrateSurface);
    }
    else
    {
      surfaceMaterialInteractionSample = opaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSample(
        opaqueSurfaceMaterialInteraction, randomState, tangentToWorldSpaceQuaternion, minimalRayInteraction, insideMedium, penetrateSurface);
    }

    break;
  }
}

SurfaceMaterialInteractionPSRSample opaqueSurfaceMaterialInteractionCalcPSRReflectionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction)
{
  // Determine if Reflection PSR should happen based on the lobe information

  const SurfaceMaterialInteractionLobeInformation lobeInformation =
    opaqueSurfaceMaterialInteractionGetLobeInformation(opaqueSurfaceMaterialInteraction);

  // Note: Indicate reflection PSR should occur only if no diffuse lobe is present (to prevent
  // the need to split paths) and if a specular dirac lobe is present.
  if (
    lobeInformation.diffuseReflectionPresent ||
    !lobeInformation.specularReflectionPresent ||
    !lobeInformation.specularReflectionDirac ||
    any(opaqueSurfaceMaterialInteraction.emissiveRadiance > 0.0)
  )
  {
    SurfaceMaterialInteractionPSRSample materialPSRSample;
    materialPSRSample.performPSR = false;

    return materialPSRSample;
  }

  // Set up relevant input vectors

  const f16vec3 normal = opaqueSurfaceMaterialInteraction.shadingNormal;
  const f16vec3 outputDirection = minimalRayInteraction.viewDirection;

  // Calculate the microfacet normal
  // Note: Typically the microfacet normal would be sampled from so this would be known upfront in a sampling
  // method, due to being a dirac distribution though we always know it'll be the same as the normal.

  const f16vec3 microfacetNormal = normal;

  // Reflect the output direction across the microfacet normal to get the input direction

  const f16vec3 inputDirection = reflect(-outputDirection, microfacetNormal);

  // Calculate dot products used for evaluation

  const float16_t /* v.h */ outputDirectionDotMicrofacetNormal = dot(outputDirection, microfacetNormal);
  const float16_t /* n.v */ normalDotOutputDirection = outputDirectionDotMicrofacetNormal;
  const float16_t /* n.l */ normalDotInputDirection = dot(inputDirection, normal);

  if (normalDotOutputDirection < 0.0h || normalDotInputDirection < 0.0h)
  {
    SurfaceMaterialInteractionPSRSample materialPSRSample;

    materialPSRSample.performPSR = false;

    return materialPSRSample;
  }

  // Calculate the attenuation of the sample

  const f16vec3 fresnel = evalOpaqueSchlickFresnel(
    opaqueSurfaceMaterialInteraction.baseReflectivity, outputDirectionDotMicrofacetNormal);

  // Todo: Pass in a material mode similar to the resolve mode to control this sort of material simplification option.
#ifdef OPAQUE_MATERIAL_USE_THIN_FILM
  // Note: Compute an approximate refractive index for the material for the thin film math, currently assuming the opaque material is always
  // surrounded by a vacuum (not true in all cases but good enough for this approximation).
  const float16_t refractiveIndex = baseReflectivityToIoR(
    materialIoRVacuum, calcBt709Luminance(opaqueSurfaceMaterialInteraction.baseReflectivity));
  const bool useThinFilm = opaqueSurfaceMaterialInteraction.thinFilmThickness > 0.0;
  const float16_t thinFilmThickness = opaqueSurfaceMaterialInteraction.thinFilmThickness * OPAQUE_SURFACE_MATERIAL_THIN_FILM_MAX_THICKNESS; // convert [0,1] range to nm
  // Note: Matching the refractive index calculation, compute the thin film assuming the material is surrounded by a vacuum and with a fixed layer IoR.
  const f16vec3 thinFilmFresnel = evalThinFilmFresnel(
    materialIoRVacuum, materialIoRThinFilmLayer, refractiveIndex,
    thinFilmThickness, outputDirectionDotMicrofacetNormal);

  const f16vec3 finalFresnel = useThinFilm ? thinFilmFresnel : fresnel;
#else
  const f16vec3 finalFresnel = fresnel;
#endif

  const f16vec3 attenuation = finalFresnel;

  // Return the material sample

  SurfaceMaterialInteractionPSRSample materialPSRSample;

  materialPSRSample.performPSR = true;
  materialPSRSample.useAlternateDisocclusionThreshold = opaqueSurfaceMaterialInteraction.normalDetail > float16_t(cb.psrrNormalDetailThreshold);
  materialPSRSample.inputDirection = inputDirection;
  materialPSRSample.attenuation = attenuation;
  materialPSRSample.vectorTransform = getReflectionQuaternion(microfacetNormal);

  return materialPSRSample;
}

SurfaceMaterialInteractionPSRSample opaqueSurfaceMaterialInteractionCalcPSRTransmissionSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  inout bool insideMedium, inout bool penetrateSurface)
{
  unused(insideMedium);
  unused(penetrateSurface);
  
  SurfaceMaterialInteractionPSRSample materialPSRSample;

  // Todo: Experimentally test transmission PSR for opacity in the future, for now not needed though.
  materialPSRSample.performPSR = false;

  return materialPSRSample;
}

void opaqueSurfaceMaterialInteractionCalcPSRSample(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  inout SurfaceMaterialInteractionPSRSample surfaceMaterialInteractionReflectionPSRSample,
  inout SurfaceMaterialInteractionPSRSample surfaceMaterialInteractionTransmissionPSRSample,
  inout f16vec3 diffuseLayerWeight,
  inout bool reflectionSelectedIntegrationSurface,
  inout float16_t selectedIntegrationSurfacePdf,
  inout bool insideMedium, inout bool penetrateSurface)
{
  unused(diffuseLayerWeight);
  
  // Sample Reflection PSR

  surfaceMaterialInteractionReflectionPSRSample = opaqueSurfaceMaterialInteractionCalcPSRReflectionSample(
    opaqueSurfaceMaterialInteraction, minimalRayInteraction);

  // Sample Transmission PSR

  surfaceMaterialInteractionTransmissionPSRSample = opaqueSurfaceMaterialInteractionCalcPSRTransmissionSample(
    opaqueSurfaceMaterialInteraction, minimalRayInteraction, insideMedium, penetrateSurface);

  // Determine which PSR surface should be selected for integration and the probability of this choice

  // Note: Reflection PSR is the only thing that can realistically happen in the opaque material currently.
  if (surfaceMaterialInteractionReflectionPSRSample.performPSR)
  {
    reflectionSelectedIntegrationSurface = true;
    selectedIntegrationSurfacePdf = 1.0f;
  }
  else // Implicitly: if (surfaceMaterialInteractionTransmissionPSRSample.performPSR)
  {
    reflectionSelectedIntegrationSurface = false;
    selectedIntegrationSurfacePdf = 1.0f;
  }
}

float opaqueSurfaceMaterialInteractionCalcDiffuseReflectionSolidAnglePdf(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  f16vec3 inputDirection)
{
  const float cosTheta = dot(inputDirection, opaqueSurfaceMaterialInteraction.shadingNormal);
  const float solidAnglePdf = getCosineHemisphereSolidAnglePdf(saturate(cosTheta));

  return solidAnglePdf;
}

float opaqueSurfaceMaterialInteractionCalcSpecularReflectionSolidAnglePdf(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  f16vec3 worldInputDirection)
{
  const f16vec4 tangentToWorldSpaceQuaternion =
    quaternionCreateOrientation(materialTangentSpaceNormal, opaqueSurfaceMaterialInteraction.shadingNormal);
  const f16vec4 worldToTangentSpaceQuaternion = quaternionInverse(tangentToWorldSpaceQuaternion);

  // Set up relevant input vectors in tangent space

  const f16vec3 outputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, minimalRayInteraction.viewDirection);
  const f16vec3 inputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, worldInputDirection);

  // Calculate the microfacet normal

  const f16vec3 microfacetNormal = normalize(inputDirection + outputDirection);

  // Calculate dot products used for evaluation
  // Note: Dot products against tangent space basis vectors are single components of the other vector

  const float16_t /* v.h */ outputDirectionDotMicrofacetNormal = dot(outputDirection, microfacetNormal);
  const float16_t /* t.v */ tangentDotOutputDirection = outputDirection.x;
  const float16_t /* b.v */ bitangentDotOutputDirection = outputDirection.y;
  const float16_t /* n.v */ normalDotOutputDirection = outputDirection.z;
  const float16_t /* t.l */ tangentDotInputDirection = inputDirection.x;
  const float16_t /* b.l */ bitangentDotInputDirection = inputDirection.y;
  const float16_t /* n.l */ normalDotInputDirection = inputDirection.z;
  const float16_t /* t.h */ tangentDotMicrofacetNormal = microfacetNormal.x;
  const float16_t /* b.h */ bitangentDotMicrofacetNormal = microfacetNormal.y;
  const float16_t /* n.h */ normalDotMicrofacetNormal = microfacetNormal.z;

  // Todo: Sanity check if inputDirection is facing the wrong direction (Into the surface), currently this does not have much
  // effect and getting the triangle normal here requires a fairly high memory bandwidth cost, so for now it is not done

  if (normalDotOutputDirection < 0.0h || normalDotInputDirection < 0.0h)
  {
    return 0.0f;
  }

  // Calculate the solid angle PDF of the sample

#if OPAQUE_MATERIAL_USE_BOUNDED_VNDF_SAMPLING
  const float solidAnglePdf = evalGGXBoundedVisibleNormalDistributionSamplePdf(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotOutputDirection, bitangentDotOutputDirection, normalDotOutputDirection,
    tangentDotMicrofacetNormal, bitangentDotMicrofacetNormal, normalDotMicrofacetNormal,
    outputDirectionDotMicrofacetNormal);
#else
  const float solidAnglePdf = evalGGXVisibleNormalDistributionSamplePdf(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotOutputDirection, bitangentDotOutputDirection, normalDotOutputDirection,
    tangentDotMicrofacetNormal, bitangentDotMicrofacetNormal, normalDotMicrofacetNormal,
    outputDirectionDotMicrofacetNormal);
#endif

  return solidAnglePdf;
}

float opaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSolidAnglePdf(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  f16vec3 inputDirection)
{
  const float cosTheta = dot(-inputDirection, opaqueSurfaceMaterialInteraction.shadingNormal);
  const float solidAnglePdf = getCosineHemisphereSolidAnglePdf(saturate(cosTheta));

  return solidAnglePdf;
}

float opaqueSurfaceMaterialInteractionCalcSolidAnglePdf(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  f16vec3 inputDirection)
{
  // Return the average of all the lobe PDFs
  // Note: Only lobes which are possible and specifically involved in reflections are included

  float16_t diffuseReflectionProbability = 0.0f;
  float16_t specularReflectionProbability = 0.0f;
  float16_t opacityTransmissionProbability = 0.0f;
  float16_t diffuseTransmissionProbability = 0.0f;
  const bool isValid = opaqueSurfaceMaterialInteractionCalcLobeProbability(
    opaqueSurfaceMaterialInteraction, minimalRayInteraction.viewDirection,
    diffuseReflectionProbability, specularReflectionProbability, opacityTransmissionProbability, diffuseTransmissionProbability);

  const float diffuseSolidAnglePdf = opaqueSurfaceMaterialInteractionCalcDiffuseReflectionSolidAnglePdf(opaqueSurfaceMaterialInteraction, minimalRayInteraction, inputDirection);
  const float specularSolidAnglePdf = opaqueSurfaceMaterialInteractionCalcSpecularReflectionSolidAnglePdf(opaqueSurfaceMaterialInteraction, minimalRayInteraction, inputDirection);
  const float diffuseTransmissionSolidAnglePdf = opaqueSurfaceMaterialInteractionCalcDiffuseTransmissionSolidAnglePdf(opaqueSurfaceMaterialInteraction, minimalRayInteraction, inputDirection);

  return diffuseSolidAnglePdf * diffuseReflectionProbability +
         specularSolidAnglePdf * specularReflectionProbability +
         diffuseTransmissionSolidAnglePdf * diffuseTransmissionProbability;
}


SurfaceMaterialInteractionSplitWeight opaqueSurfaceMaterialInteractionCalcApproxProjectedWeight(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  f16vec3 inputDirection)
{
  const f16vec3 microfacetNormal = normalize(inputDirection + minimalRayInteraction.viewDirection);
  const float16_t /* n.h */ normalDotMicrofacetNormal = dot(opaqueSurfaceMaterialInteraction.shadingNormal, microfacetNormal);
  const float16_t /* v.h */ outputDirectionDotMicrofacetNormal = dot(minimalRayInteraction.viewDirection, microfacetNormal);
  const float16_t /* n.l */ normalDotInputDirection = dot(inputDirection, opaqueSurfaceMaterialInteraction.shadingNormal);
  const float16_t /* n.v */ normalDotOutputDirection = dot(minimalRayInteraction.viewDirection, opaqueSurfaceMaterialInteraction.shadingNormal);

  // Load Subsurface Material
  const SubsurfaceMaterial subsurfaceMaterial = subsurfaceMaterialCreate(opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction);
  const bool isThinOpaqueSubsurface = isThinOpaqueSubsurfaceMaterial(opaqueSurfaceMaterialInteraction);
  const bool isSss = isSubsurfaceDiffusionProfileMaterial(opaqueSurfaceMaterialInteraction);

  f16vec3 diffuseTransmissionWeight = f16vec3(0.0, 0.0, 0.0);
  if (isThinOpaqueSubsurface || isSss)
  {
    diffuseTransmissionWeight = subsurfaceMaterial.singleScatteringAlbedo;
  }

  if (normalDotOutputDirection < 0.0h || normalDotInputDirection < 0.0h)
  {
    SurfaceMaterialInteractionSplitWeight splitWeight;

    splitWeight.diffuseReflectionWeight = f16vec3(0.0, 0.0, 0.0);
    splitWeight.specularReflectionWeight = f16vec3(0.0, 0.0, 0.0);

    if (normalDotOutputDirection < 0.0h)
    {
      if (!isSss)
      {
        splitWeight.diffuseTransmissionWeight = f16vec3(0.0, 0.0, 0.0);
      }
      else
      {
        // SSS Transmission could cause the angle between view direction (output) and backface normal larger than 90 degrees.
        // In such case we use the inversed dot product result to estimate the transmission weight.
        splitWeight.diffuseTransmissionWeight = diffuseTransmissionWeight * (-normalDotOutputDirection);
      }
    }
    else
    {
      splitWeight.diffuseTransmissionWeight = diffuseTransmissionWeight * (-normalDotInputDirection);
    }

    return splitWeight;
  }

  // Calculate the weight
  const f16vec3 fresnel = evalOpaqueSchlickFresnel(opaqueSurfaceMaterialInteraction.baseReflectivity, outputDirectionDotMicrofacetNormal);
  const float16_t normalDistributionFunction = evalGGXNormalDistributionIsotropic(opaqueSurfaceMaterialInteraction.isotropicRoughness, normalDotMicrofacetNormal);
  // Note: Actual shadowing/masking (G) function omitted from visibility calculation for a cheaper approximation.
  const float16_t visibility = safePositiveDivide(float16_t(1), float16_t(4) * normalDotInputDirection * normalDotOutputDirection, materialEpsilon);
  const f16vec3 diffuseReflectionWeight = opaqueSurfaceMaterialInteraction.albedo;
  const f16vec3 specularReflectionWeight = min(normalDistributionFunction * visibility * fresnel, f16vec3(float16Max));

  // Create a split weight
  SurfaceMaterialInteractionSplitWeight splitWeight;
  splitWeight.diffuseReflectionWeight = diffuseReflectionWeight * normalDotInputDirection;
  splitWeight.specularReflectionWeight = specularReflectionWeight * normalDotInputDirection;
  splitWeight.diffuseTransmissionWeight = f16vec3(0.0, 0.0, 0.0); // Will always be 0 when normalDotInputDirection >= 0

  return splitWeight;
}

SurfaceMaterialInteractionSplitWeight opaqueSurfaceMaterialInteractionCalcProjectedWeight(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction,
  MinimalRayInteraction minimalRayInteraction,
  f16vec3 inputDirection)
{
  const f16vec4 tangentToWorldSpaceQuaternion =
    quaternionCreateOrientation(materialTangentSpaceNormal, opaqueSurfaceMaterialInteraction.shadingNormal);
  const f16vec4 worldToTangentSpaceQuaternion = quaternionInverse(tangentToWorldSpaceQuaternion);

  // Set up relevant input vectors in tangent space

  const f16vec3 tangentOutputDirection =
    quaternionTransformVector(worldToTangentSpaceQuaternion, minimalRayInteraction.viewDirection);
  const f16vec3 tangentInputDirection = quaternionTransformVector(worldToTangentSpaceQuaternion, inputDirection);

  // Calculate the microfacet normal from the input and output directions

  const f16vec3 microfacetNormal = normalize(tangentInputDirection + tangentOutputDirection);

  // Calculate dot products used for evaluation

  const float16_t /* l.v */ inputDirectionDotOutputDirection = dot(tangentInputDirection, tangentOutputDirection);
  const float16_t /* v.h */ outputDirectionDotMicrofacetNormal = dot(tangentOutputDirection, microfacetNormal);
  const float16_t /* t.v */ tangentDotOutputDirection = tangentOutputDirection.x;
  const float16_t /* b.v */ bitangentDotOutputDirection = tangentOutputDirection.y;
  const float16_t /* n.v */ normalDotOutputDirection = tangentOutputDirection.z;
  const float16_t /* t.l */ tangentDotInputDirection = tangentInputDirection.x;
  const float16_t /* b.l */ bitangentDotInputDirection = tangentInputDirection.y;
  const float16_t /* n.l */ normalDotInputDirection = tangentInputDirection.z;
  const float16_t /* t.h */ tangentDotMicrofacetNormal = microfacetNormal.x;
  const float16_t /* b.h */ bitangentDotMicrofacetNormal = microfacetNormal.y;
  const float16_t /* n.h */ normalDotMicrofacetNormal = microfacetNormal.z;
  const float16_t /*-n.l */ transmissionNormalDotInputDirection = -tangentInputDirection.z;

  // Load Subsurface Material
  const SubsurfaceMaterial subsurfaceMaterial = subsurfaceMaterialCreate(opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction);
  const bool isThinOpaqueSubsurface = isThinOpaqueSubsurfaceMaterial(opaqueSurfaceMaterialInteraction);

  f16vec3 diffuseTransmissionWeight = f16vec3(0.0h, 0.0h, 0.0h);
  if (isThinOpaqueSubsurface && normalDotOutputDirection > 0.0h) {
    diffuseTransmissionWeight = evalHanrahanSingleScatteringDiffuseTransmission(
      opaqueSurfaceMaterialInteraction.baseReflectivity,
      subsurfaceMaterial.volumetricAttenuationCoefficient, subsurfaceMaterial.measurementDistance,
      subsurfaceMaterial.singleScatteringAlbedo, subsurfaceMaterial.volumetricAnisotropy,
      normalDotOutputDirection,
      transmissionNormalDotInputDirection,
      inputDirectionDotOutputDirection);
  }

  if (normalDotOutputDirection < 0.0h || normalDotInputDirection < 0.0h)
  {
    SurfaceMaterialInteractionSplitWeight splitWeight;

    splitWeight.diffuseReflectionWeight = f16vec3(0.0, 0.0, 0.0);
    splitWeight.specularReflectionWeight = f16vec3(0.0, 0.0, 0.0);
    splitWeight.diffuseTransmissionWeight = diffuseTransmissionWeight * transmissionNormalDotInputDirection;

    return splitWeight;
  }

  // Calculate the weight

  const f16vec3 fresnel = evalOpaqueSchlickFresnel(
    opaqueSurfaceMaterialInteraction.baseReflectivity, outputDirectionDotMicrofacetNormal);

  // Todo: Pass in a material mode similar to the resolve mode to control this sort of material simplification option.
#ifdef OPAQUE_MATERIAL_USE_THIN_FILM
  // Note: Compute an approximate refractive index for the material for the thin film math, currently assuming the opaque material is always
  // surrounded by a vacuum (not true in all cases but good enough for this approximation).
  const float16_t refractiveIndex = baseReflectivityToIoR(
    materialIoRVacuum, calcBt709Luminance(opaqueSurfaceMaterialInteraction.baseReflectivity));
  const bool useThinFilm = opaqueSurfaceMaterialInteraction.thinFilmThickness > 0.0;
  const float16_t thinFilmThickness = opaqueSurfaceMaterialInteraction.thinFilmThickness * OPAQUE_SURFACE_MATERIAL_THIN_FILM_MAX_THICKNESS; // convert [0,1] range to nm
  // Note: Matching the refractive index calculation, compute the thin film assuming the material is surrounded by a vacuum and with a fixed layer IoR.
  const f16vec3 thinFilmFresnel = evalThinFilmFresnel(
    materialIoRVacuum, materialIoRThinFilmLayer, refractiveIndex,
    thinFilmThickness, outputDirectionDotMicrofacetNormal);

  const f16vec3 finalFresnel = useThinFilm ? thinFilmFresnel : fresnel;
#else
  const f16vec3 finalFresnel = fresnel;
#endif

  const float16_t normalDistributionFunction = evalGGXNormalDistribution(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotMicrofacetNormal, bitangentDotMicrofacetNormal, normalDotMicrofacetNormal);
  const float16_t visibility = evalHeightCorrelatedGGXVisibility(
    opaqueSurfaceMaterialInteraction.anisotropicRoughness,
    tangentDotInputDirection, tangentDotOutputDirection, bitangentDotInputDirection,
    bitangentDotOutputDirection, normalDotInputDirection, normalDotOutputDirection);

  // Note: Thin film Fresnel not taken into account properly here. If we were using a simpler diffuse model where the transmission Fresnel was simply multiplied in somewhere
  // it'd be doable to incorporate like we do with specular, but currently the Hammon Diffuse model does Fresnel calculations internally based on various assumptions in its derivation
  // which makes it non-trivial to modify. This should be fine though as the thin film will only add a small bit of extra reflection in some cases (due to having two Fresnel layers),
  // or attenuate the reflected signal due to destructive interference, nothing major enough that'd majorly change the amount of transmitted light to make the diffuse contribution look very
  // wrong, though it may be slightly the wrong color in some instances, assuming that transmitted light interferes in the same way.
  const f16vec3 diffuseReflectionWeight = evalHammonDiffuse(
    opaqueSurfaceMaterialInteraction.albedo, opaqueSurfaceMaterialInteraction.isotropicRoughness,
    inputDirectionDotOutputDirection, normalDotInputDirection,
    normalDotOutputDirection, normalDotMicrofacetNormal);
  const f16vec3 specularReflectionWeight = min(finalFresnel * normalDistributionFunction * visibility, f16vec3(float16Max));

  // Create a split weight

  SurfaceMaterialInteractionSplitWeight splitWeight;

  splitWeight.diffuseReflectionWeight = diffuseReflectionWeight * normalDotInputDirection;
  splitWeight.specularReflectionWeight = specularReflectionWeight * normalDotInputDirection;
  splitWeight.diffuseTransmissionWeight = diffuseTransmissionWeight * normalDotInputDirection;

  return splitWeight;
}

f16vec3 opaqueSurfaceMaterialInteractionEvalEmissiveRadiance(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  return opaqueSurfaceMaterialInteraction.emissiveRadiance;
}

f16vec3 opaqueSurfaceMaterialGetAdjustedBaseReflectivity(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  // Note: Simple max taken between the specular reflection base reflectivity and a monochromatic "transmission" factor
  // based on the opacity to ensure if any contribution is in the specular lobe it will be properly represented.
  const f16vec3 adjustedBaseReflectivity = max(
    opaqueSurfaceMaterialInteraction.baseReflectivity,
    f16vec3(float16_t(1.0f) - opaqueSurfaceMaterialInteraction.opacity));

  return adjustedBaseReflectivity;
}

bool opaqueSurfaceMaterialInteractionHasHeightTexture(
  OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteraction)
{
  return opaqueSurfaceMaterialInteraction.flags & OPAQUE_SURFACE_MATERIAL_INTERACTION_FLAG_HAS_HEIGHT_TEXTURE;
}
